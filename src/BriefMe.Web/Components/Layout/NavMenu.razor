@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="flex h-full flex-col gap-6 p-[20px]">
    <a href="" class="px-4 text-subhead font-bold text-primary">BriefMe</a>

    <nav class="flex flex-1 flex-col gap-1" aria-label="Navegação principal">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Início</NavLink>

        <AuthorizeView Roles="@nameof(UserRole.Requester)">
            <NavLink class="nav-link" href="briefings/meus">Meus briefings</NavLink>
            <NavLink class="nav-link" href="briefings/novo">Novo briefing</NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="@nameof(UserRole.Designer)">
            <NavLink class="nav-link" href="briefings/fila">Fila de briefings</NavLink>
            <NavLink class="nav-link" href="briefings/meu-trabalho">Meu trabalho</NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="@nameof(UserRole.Admin)">
            <NavLink class="nav-link" href="usuarios">Usuários</NavLink>
            <NavLink class="nav-link" href="categorias">Categorias</NavLink>
        </AuthorizeView>
    </nav>

    <AuthorizeView>
        <Button Variant="ButtonVariant.Outline" OnClick="LogoutAsync" Loading="_isLoggingOut">
            @(_isLoggingOut ? "Saindo..." : "Sair")
        </Button>
    </AuthorizeView>
</div>

@code {
    private bool _isLoggingOut;

    private async Task LogoutAsync()
    {
        _isLoggingOut = true;
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", replace: true);
    }
}
