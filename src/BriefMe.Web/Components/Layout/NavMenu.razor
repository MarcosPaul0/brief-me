@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="flex h-full flex-col gap-6 p-[20px]">
    <a href="" class="text-[20px] font-medium tracking-[-0.4px] text-white">BriefMe</a>

    <nav class="flex flex-1 flex-col gap-1" aria-label="Navegação principal">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Início</NavLink>

        <AuthorizeView Policy="briefings.view-own">
            <NavLink class="nav-link" href="briefings/meus">Meus briefings</NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="briefings.create">
            <NavLink class="nav-link" href="briefings/novo">Novo briefing</NavLink>
        </AuthorizeView>




        <AuthorizeView Policy="users.view">
            <NavLink class="nav-link" href="usuarios">Usuários</NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="roles.manage">
            <NavLink class="nav-link" href="perfis">Perfis</NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="permissions.manage">
            <NavLink class="nav-link" href="permissoes">Permissões</NavLink>
        </AuthorizeView>
    </nav>

    <AuthorizeView>
        <button type="button" @onclick="LogoutAsync" disabled="@_isLoggingOut"
                class="inline-flex items-center justify-center rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-white transition hover:bg-[#262626] disabled:cursor-not-allowed disabled:opacity-60">
            @(_isLoggingOut ? "Saindo..." : "Sair")
        </button>
    </AuthorizeView>
</div>

@code {
    private bool _isLoggingOut;

    private async Task LogoutAsync()
    {
        _isLoggingOut = true;
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", replace: true);
    }
}
