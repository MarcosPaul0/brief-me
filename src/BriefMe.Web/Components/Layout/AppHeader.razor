@*
    Global bar (DESIGN-clay.md top-nav): 64px, full-bleed, cream canvas. Wordmark on the left, the role's nav links
    beside it as category-tab pills, the signed-in user and "Sair" on the right. Below sm the links drop to a second row that scrolls
    sideways inside itself rather than widening the page.
*@
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<header class="sticky top-0 z-40 border-b border-hairline-soft bg-canvas">
    <div class="mx-auto flex h-16 max-w-[1100px] items-center gap-8 px-4 sm:px-8">
        <a href="" class="flex items-center gap-2 text-title-lg text-ink">
            <span class="flex size-8 items-center justify-center rounded-md bg-primary text-on-primary">
                <Icon Name="IconName.FileText" Size="18" />
            </span>
            BriefMe
        </a>

        <nav class="hidden items-center gap-1 sm:flex" aria-label="Navegação principal">
            @NavLinks
        </nav>

        <AuthorizeView>
            <div class="ml-auto flex items-center gap-4">
                <span class="hidden max-w-[200px] items-center gap-1.5 text-nav-link text-muted md:flex">
                    <Icon Name="IconName.User" />
                    <span class="truncate">@context.User.Identity?.Name</span>
                </span>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Icon="IconName.LogOut" OnClick="LogoutAsync" Loading="_isLoggingOut">
                    @(_isLoggingOut ? "Saindo..." : "Sair")
                </Button>
            </div>
        </AuthorizeView>
    </div>

    <nav class="flex items-center gap-1 overflow-x-auto border-t border-hairline-soft px-4 py-2 sm:hidden" aria-label="Navegação principal">
        @NavLinks
    </nav>
</header>

@code {
    private bool _isLoggingOut;

    private RenderFragment NavLinks => __builder =>
    {
        <AuthorizeView Roles="@nameof(UserRole.Requester)" Context="_">
            <NavLink class="nav-link" href="briefings/meus"><Icon Name="IconName.FileText" />Meus briefings</NavLink>
            <NavLink class="nav-link" href="briefings/novo"><Icon Name="IconName.FilePlus" />Novo briefing</NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="@nameof(UserRole.Designer)" Context="_">
            <NavLink class="nav-link" href="briefings/meu-trabalho"><Icon Name="IconName.Briefcase" />Meu trabalho</NavLink>
            <NavLink class="nav-link" href="briefings/fila"><Icon Name="IconName.Inbox" />Fila de briefings</NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="@nameof(UserRole.Admin)" Context="_">
            <NavLink class="nav-link" href="usuarios"><Icon Name="IconName.Users" />Usuários</NavLink>
            <NavLink class="nav-link" href="categorias"><Icon Name="IconName.Tag" />Categorias</NavLink>
        </AuthorizeView>
    };

    private async Task LogoutAsync()
    {
        _isLoggingOut = true;
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", replace: true);
    }
}
