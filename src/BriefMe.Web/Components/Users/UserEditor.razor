@using BriefMe.Application.Common.Dtos
@using BriefMe.Application.UseCases.Users
@using BriefMe.Domain.Common
@using BriefMe.Domain.Enums
@using BriefMe.Web.Contracts.Users
@using System.ComponentModel.DataAnnotations
@inject IUsersApiClient UsersApi
@inject AuthSessionStore SessionStore
@inject NavigationManager NavigationManager

<div class="min-h-full bg-[#090909] px-4 py-8 text-white sm:px-8">
    <div class="mx-auto max-w-[560px]">
        <div class="flex items-center justify-between gap-4">
            <div>
                <h1 class="text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">@Title</h1>
                <p class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">@Subtitle</p>
            </div>
        </div>

        <div class="mt-[30px]">
            @if (_isLoading)
            {
                <div class="flex items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-[15px] text-[#999999]">
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
                    <span>Carregando...</span>
                </div>
            }
            else if (_notFound)
            {
                <div class="flex flex-col items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-center">
                    <p class="text-[15px] text-white">Usuário não encontrado</p>
                    <button type="button" @onclick="NavigateToList"
                            class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                        Voltar para a lista
                    </button>
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="flex flex-col items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-center">
                    <p class="text-[15px] text-[#ef4444]">@_loadError</p>
                    <button type="button" @onclick="NavigateToList"
                            class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                        Voltar para a lista
                    </button>
                </div>
            }
            else
            {
                <EditForm EditContext="_editContext" FormName="userEditor" OnValidSubmit="HandleValidSubmitAsync"
                          class="flex flex-col gap-[15px] rounded-[20px] border border-[#262626] bg-[#141414] p-[30px]">
                    <DataAnnotationsValidator />

                    @if (_generalError is not null)
                    {
                        <div role="alert" class="rounded-[10px] border border-[#ef4444]/30 bg-[#ef4444]/10 px-[14px] py-[10px] text-[14px] text-[#ef4444]">
                            @_generalError
                        </div>
                    }

                    <div class="flex flex-col gap-1">
                        <label for="fullName" class="text-[13px] font-medium text-[#999999]">Nome</label>
                        <InputText id="fullName" @bind-Value="_model.FullName" disabled="@_isSubmitting"
                                   class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white placeholder:text-[#999999] focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50" />
                        <ValidationMessage For="() => _model.FullName" class="text-[13px] text-[#ef4444]" />
                    </div>

                    <div class="flex flex-col gap-1">
                        <label for="email" class="text-[13px] font-medium text-[#999999]">E-mail</label>
                        <InputText id="email" @bind-Value="_model.Email" type="email" autocomplete="off" disabled="@_isSubmitting"
                                   class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white placeholder:text-[#999999] focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50" />
                        <ValidationMessage For="() => _model.Email" class="text-[13px] text-[#ef4444]" />
                    </div>

                    @if (!IsEdit)
                    {
                        <div class="flex flex-col gap-1">
                            <label for="password" class="text-[13px] font-medium text-[#999999]">Senha</label>
                            <InputText id="password" @bind-Value="_model.Password" type="password" autocomplete="new-password" disabled="@_isSubmitting"
                                       class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white placeholder:text-[#999999] focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50" />
                            <ValidationMessage For="() => _model.Password" class="text-[13px] text-[#ef4444]" />
                            <p class="text-[12px] text-[#999999]">Mínimo 8 caracteres, com maiúscula, minúscula e número.</p>
                        </div>
                    }

                    <div class="flex flex-col gap-1">
                        <label for="role" class="text-[13px] font-medium text-[#999999]">Perfil</label>
                        <InputSelect id="role" TValue="UserRole" @bind-Value="_model.Role" disabled="@_isSubmitting"
                                     class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50">
                            @foreach (var role in UserRoleLabels.All)
                            {
                                <option value="@role">@UserRoleLabels.Label(role)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _model.Role" class="text-[13px] text-[#ef4444]" />
                    </div>

                    <div class="mt-2 flex items-center justify-end gap-2">
                        <button type="button" @onclick="NavigateToList" disabled="@_isSubmitting"
                                class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626] disabled:opacity-50">
                            Cancelar
                        </button>
                        <button type="submit" disabled="@_isSubmitting"
                                class="inline-flex items-center gap-2 rounded-[100px] bg-white px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-black transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60">
                            @if (_isSubmitting)
                            {
                                <span class="h-4 w-4 animate-spin rounded-full border-2 border-black/30 border-t-black"></span>
                                <span>Salvando...</span>
                            }
                            else
                            {
                                <span>Salvar</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Null in create mode; the target user's id in edit mode.</summary>
    [Parameter]
    public Guid? UserId { get; set; }

    private static readonly string[] FieldNames = [nameof(UserFormModel.FullName), nameof(UserFormModel.Email), nameof(UserFormModel.Password), nameof(UserFormModel.Role)];

    private bool IsEdit => UserId.HasValue;
    private string Title => IsEdit ? "Editar usuário" : "Novo usuário";
    private string Subtitle => IsEdit ? "Atualize os dados e o perfil do usuário." : "Preencha os dados para cadastrar um novo usuário.";

    private bool _isLoading = true;
    private bool _notFound;
    private string? _loadError;
    private string? _generalError;
    private bool _isSubmitting;

    private UserFormModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;

    protected override async Task OnInitializedAsync()
    {
        // No token before the interactive restore — same guard as Login.razor / Users.razor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        if (IsEdit)
        {
            var result = await UsersApi.GetUserAsync(UserId!.Value);
            if (result.IsFailure)
            {
                if (result.Type == ErrorType.NotFound)
                    _notFound = true;
                else
                    _loadError = result.Error;

                _isLoading = false;
                return;
            }

            _model.FullName = result.Value.FullName;
            _model.Email = result.Value.Email;

            _model.Role = result.Value.Role;
        }

        _model.RequirePassword = !IsEdit;
        InitializeEditContext();
        _isLoading = false;
    }

    private void InitializeEditContext()
    {
        _editContext = new EditContext(_model);
        _messageStore = new ValidationMessageStore(_editContext);
        // Clear a field's server-side message as soon as the user edits it, so stale API errors don't linger.
        _editContext.OnFieldChanged += (_, args) => _messageStore.Clear(args.FieldIdentifier);
    }

    private async Task HandleValidSubmitAsync()
    {
        _generalError = null;
        _messageStore.Clear();

        _isSubmitting = true;

        var result = IsEdit
            ? await UsersApi.UpdateUserAsync(UserId!.Value, new UpdateUserRequest(_model.FullName, _model.Email, _model.Role))
            : await UsersApi.CreateUserAsync(new CreateUserRequest(_model.FullName, _model.Email, _model.Password, _model.Role));

        if (result.IsSuccess)
        {
            NavigateToList();
            return;
        }

        ApplyFailure(result);
        _isSubmitting = false;
    }

    private void ApplyFailure(Result result)
    {
        if (result.Errors.Count == 0)
        {
            _generalError = result.Error;
            return;
        }

        var unmapped = new List<string>();
        foreach (var error in result.Errors)
        {
            if (FieldNames.Contains(error.PropertyName))
                _messageStore.Add(new FieldIdentifier(_model, error.PropertyName), error.ErrorMessage);
            else
                unmapped.Add(error.ErrorMessage);
        }

        _editContext.NotifyValidationStateChanged();

        if (unmapped.Count > 0)
            _generalError = string.Join(" ", unmapped);
    }

    private void NavigateToList() => NavigationManager.NavigateTo("/usuarios");

    private sealed class UserFormModel : IValidatableObject
    {
        private const int MinPasswordLength = 8;

        [Required(ErrorMessage = "Nome é obrigatório.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "E-mail é obrigatório.")]
        [EmailAddress(ErrorMessage = "E-mail em formato inválido.")]
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public UserRole Role { get; set; } = UserRole.Requester;

        /// <summary>True only in create mode — mirrors the server-side password policy on the client.</summary>
        public bool RequirePassword { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!RequirePassword)
                yield break;

            var member = new[] { nameof(Password) };

            if (string.IsNullOrWhiteSpace(Password))
                yield return new ValidationResult("Senha é obrigatória.", member);
            else if (Password.Length < MinPasswordLength)
                yield return new ValidationResult($"Senha deve ter ao menos {MinPasswordLength} caracteres.", member);
            else if (!Password.Any(char.IsUpper))
                yield return new ValidationResult("Senha deve conter ao menos uma letra maiúscula.", member);
            else if (!Password.Any(char.IsLower))
                yield return new ValidationResult("Senha deve conter ao menos uma letra minúscula.", member);
            else if (!Password.Any(char.IsDigit))
                yield return new ValidationResult("Senha deve conter ao menos um número.", member);
        }
    }
}
