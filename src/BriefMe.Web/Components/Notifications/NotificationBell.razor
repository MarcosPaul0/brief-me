@* BRF-054 (RF031–RF035) — the in-app notification bell.
   No permission gate: an inbox is the caller's own rows and the API scopes every read to the authenticated
   identity, so holding an account is the whole condition (see the slice's spec, decision #2).
   Opening the panel loads the page first and marks everything read second: a failed load must not clear a
   badge over notifications the reader never saw. Each row keeps the read state it was loaded with, so the
   opening that marks them still shows which ones were new.
   The badge refreshes by polling, not by push — the writer is sometimes a BackgroundService with no circuit
   (BRF-043), so a push would need a process-wide registry and a backplane. RefreshUnreadCountAsync is the
   single seam a push would replace. *@
@using BriefMe.Application.Common.Dtos
@using BriefMe.Web.Contracts.Common
@implements IAsyncDisposable
@inject INotificationsApiClient NotificationsApi
@inject AuthSessionStore SessionStore

<AuthorizeView>
    <div class="relative">
        <button type="button" @onclick="ToggleAsync" aria-label="@AriaLabel" aria-expanded="@_isOpen"
                class="relative inline-flex h-[40px] w-[40px] shrink-0 items-center justify-center rounded-full bg-[#1c1c1c] text-white transition hover:bg-[#262626]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>

            @* No badge at zero: an explicit "0" is noise on chrome that is read at a glance. *@
            @if (_unreadCount > 0)
            {
                <span class="absolute -right-[2px] -top-[2px] inline-flex min-w-[18px] items-center justify-center rounded-full bg-[#0099ff] px-[5px] py-[2px] text-[12px] font-medium leading-[1.2] tracking-[-0.12px] text-white">
                    @NotificationLabels.UnreadBadge(_unreadCount)
                </span>
            }
        </button>

        @if (_isOpen)
        {
            @* Closes on an outside click without a JS document listener: the gesture stays in Blazor, and
               the backdrop sits under the panel so the panel's own clicks never reach it. *@
            <button type="button" @onclick="Close" tabindex="-1" aria-hidden="true"
                    class="fixed inset-0 z-40 cursor-default"></button>

            <div class="absolute left-0 top-[48px] z-50 w-[360px] max-w-[calc(100vw-40px)] overflow-hidden rounded-[20px] border border-[#262626] bg-[#141414] shadow-[0_10px_30px_rgba(0,0,0,0.45)]">
                <div class="flex items-baseline justify-between gap-2 border-b border-[#262626] px-[20px] py-[14px]">
                    <h2 class="text-[15px] font-medium leading-[1.3] tracking-[-0.15px] text-white">Notificações</h2>
                    <span class="text-[13px] leading-[1.2] tracking-[-0.13px] text-[#999999]">
                        @(_page is null ? string.Empty : $"{_page.TotalCount} no total")
                    </span>
                </div>

                @if (_isLoading)
                {
                    <div class="flex items-center justify-center gap-3 py-16 text-[14px] text-[#999999]">
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
                        <span>Carregando...</span>
                    </div>
                }
                else if (_errorMessage is not null)
                {
                    <div class="flex flex-col items-center justify-center gap-3 py-16 text-center">
                        <p class="px-[20px] text-[14px] text-[#ef4444]">@_errorMessage</p>
                        <button type="button" @onclick="ReloadAsync"
                                class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[8px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                            Tentar novamente
                        </button>
                    </div>
                }
                else if (_page is null || _page.Items.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center gap-1 py-16 text-center">
                        <p class="text-[14px] text-white">Nenhuma notificação</p>
                        <p class="px-[20px] text-[13px] text-[#999999]">Avisos sobre seus briefings e tarefas aparecem aqui.</p>
                    </div>
                }
                else
                {
                    <ul class="max-h-[420px] overflow-y-auto">
                        @foreach (var notification in _page.Items)
                        {
                            @* IsRead is the state the row arrived with — the mark that follows the load
                               changes the badge, not what this opening shows. *@
                            <li class="border-b border-[#1a1a1a] px-[20px] py-[14px] last:border-b-0 @(notification.IsRead ? "" : "bg-[#1c1c1c]")">
                                <div class="flex items-center gap-2">
                                    @if (!notification.IsRead)
                                    {
                                        <span class="h-[6px] w-[6px] shrink-0 rounded-full @NotificationLabels.EventTypeDotClass(notification.EventType)" aria-hidden="true"></span>
                                    }
                                    <span class="text-[13px] font-medium leading-[1.2] tracking-[-0.13px] @NotificationLabels.EventTypeColorClass(notification.EventType)">
                                        @NotificationLabels.EventType(notification.EventType)
                                    </span>
                                    <span class="ml-auto shrink-0 text-[13px] leading-[1.2] tracking-[-0.13px] text-[#999999]">
                                        @NotificationLabels.RelativeTime(notification.CreatedAt, _now)
                                    </span>
                                </div>
                                <p class="mt-[6px] text-[14px] font-medium leading-[1.4] tracking-[-0.14px] text-white">
                                    @notification.Title
                                </p>
                                @* Clamped, never truncated server-side: the full sentence carries the
                                   justification of a rejection (RF013/RF032). *@
                                <p class="mt-[2px] line-clamp-3 text-[14px] leading-[1.4] tracking-[-0.14px] text-[#999999]">
                                    @notification.Message
                                </p>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
</AuthorizeView>

@code {
    /// <summary>How many entries the panel shows. The rest stay readable by paging the same query later.</summary>
    private const int PageSize = 10;

    /// <summary>
    /// Poll period of the badge. Matched to how fast notifications actually arrive: the burstiest producer
    /// is the deadline monitor (BRF-043), whose own period is minutes.
    /// </summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(60);

    private readonly CancellationTokenSource _cts = new();

    private PeriodicTimer? _timer;

    private bool _isOpen;
    private bool _isLoading;
    private string? _errorMessage;
    private int _unreadCount;
    private PagedResponse<NotificationDto>? _page;

    /// <summary>
    /// Reference instant the relative times on screen are measured against — read once per load, so every
    /// row of one opening is compared to the same clock.
    /// </summary>
    private DateTime _now = DateTime.UtcNow;

    private string AriaLabel => _unreadCount > 0
        ? $"Notificações: {_unreadCount} não lidas"
        : "Notificações";

    protected override async Task OnInitializedAsync()
    {
        // No interactive circuit during prerender means no restored token yet — the call would go out
        // anonymous. Same guard as TaskBoard.razor and OverdueTasksPanel.razor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        await RefreshUnreadCountAsync();

        // Not awaited: the loop lives as long as the component does, and awaiting it here would never
        // return from initialization.
        _ = PollUnreadCountAsync();
    }

    private async Task ToggleAsync()
    {
        if (_isOpen)
        {
            Close();
            return;
        }

        _isOpen = true;

        await LoadAsync();
    }

    private void Close() => _isOpen = false;

    private Task ReloadAsync() => LoadAsync();

    /// <summary>
    /// Loads the page and only then applies the read mark (BRF-054's acceptance criterion). The order is the
    /// point: marking first would empty the badge even when the reader is left looking at an error.
    /// </summary>
    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await NotificationsApi.GetNotificationsAsync(1, PageSize, _cts.Token);

        if (result.IsSuccess)
        {
            _page = result.Value;
            _now = DateTime.UtcNow;
        }
        else
        {
            _page = null;
            _errorMessage = result.Error;
        }

        _isLoading = false;
        StateHasChanged();

        if (result.IsSuccess)
            await MarkAllAsReadAsync();
    }

    /// <summary>
    /// Marks everything unread, not just what was rendered: a badge left counting over a panel the reader
    /// has just emptied is the state the criterion forbids. Idempotent in the entity, so a second opening
    /// preserves the first read instants.
    /// </summary>
    private async Task MarkAllAsReadAsync()
    {
        if (_unreadCount == 0)
            return;

        var result = await NotificationsApi.MarkAllAsReadAsync(_cts.Token);

        // A failed mark leaves the badge as it was rather than lying about it; the entries stay unread and
        // the next opening tries again. It is not surfaced as an error, because the reader did get the list.
        if (result.IsSuccess)
            _unreadCount = 0;

        StateHasChanged();
    }

    /// <summary>The one seam a real-time push would replace — the timer, the open gesture and the initial load all go through it.</summary>
    private async Task RefreshUnreadCountAsync()
    {
        var result = await NotificationsApi.GetUnreadCountAsync(_cts.Token);

        // A lost poll must not blank a badge that was correct a minute ago.
        if (result.IsSuccess)
            _unreadCount = result.Value.Count;
    }

    private async Task PollUnreadCountAsync()
    {
        _timer = new PeriodicTimer(PollInterval);

        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                // What is on screen has just been marked read; refreshing the badge underneath an open panel
                // would flicker a number the reader is in the middle of using.
                if (_isOpen)
                    continue;

                await RefreshUnreadCountAsync();

                // The timer's continuation does not run on the circuit's synchronization context.
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Disposal is the only way out of the loop, not a fault.
        }
        catch (ObjectDisposedException)
        {
            // The circuit tore the timer down between the tick and this iteration.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _timer?.Dispose();
        _cts.Dispose();
    }
}
