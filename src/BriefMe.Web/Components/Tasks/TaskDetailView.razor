@* BRF-034 (RF021, RF022, RF052) — the record behind one row of the task board: what the task is, the
   files delivered on it (with who delivered them and when) and the conversation around it.
   Thin by design: it reads GET /tasks/{id} and posts to the two write endpoints that already exist,
   holding no rule of its own beyond disabling a submit with nothing to submit. *@
@using BriefMe.Application.Common.Dtos
@using BriefMe.Domain.Common
@using BriefMe.Domain.Entities
@using BriefMe.Domain.Enums
@using BriefMe.Infrastructure.Storage
@using Microsoft.Extensions.Options
@inject ITasksApiClient TasksApi
@inject AuthSessionStore SessionStore
@inject IOptions<FileStorageSettings> FileStorageOptions

<div class="min-h-full bg-[#090909] px-4 py-8 text-white sm:px-8">
    <div class="mx-auto max-w-[880px]">
        <a href="/tarefas" class="text-[14px] font-medium tracking-[-0.14px] text-[#999999] transition hover:text-white">
            ← Voltar para minhas tarefas
        </a>

        @if (_isLoading)
        {
            <div class="mt-[20px] flex items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-[15px] text-[#999999]">
                <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
                <span>Carregando tarefa...</span>
            </div>
        }
        else if (_task is null)
        {
            <div class="mt-[20px] flex flex-col items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-center">
                <p class="text-[15px] text-white">@LoadFailureTitle</p>
                <p class="max-w-[420px] text-[14px] text-[#999999]">@_loadError</p>
                @if (_loadErrorType is not ErrorType.NotFound and not ErrorType.Forbidden)
                {
                    <button type="button" @onclick="LoadAsync"
                            class="mt-2 rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                        Tentar novamente
                    </button>
                }
            </div>
        }
        else
        {
            <div class="mt-[20px] rounded-[20px] border border-[#262626] bg-[#141414] p-[30px]">
                <p class="text-[13px] font-medium tracking-[-0.13px] text-[#999999]">
                    @(_task.BriefingTitle ?? "Briefing não identificado")
                </p>
                <h1 class="mt-1 text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">@_task.Title</h1>
                <span class="mt-3 inline-flex items-center rounded-[100px] px-[10px] py-[4px] text-[13px] font-medium @BriefingTaskLabels.StatusBadgeClass(_task.Status)">
                    @BriefingTaskLabels.Status(_task.Status)
                </span>

                <dl class="mt-[20px] grid gap-[15px] border-t border-[#262626] pt-[20px] sm:grid-cols-3">
                    <div>
                        <dt class="text-[13px] font-medium text-[#999999]">Prazo</dt>
                        <dd class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-white">
                            @(_task.Deadline?.ToString("dd/MM/yyyy") ?? "Não definido")
                        </dd>
                    </div>
                    <div>
                        <dt class="text-[13px] font-medium text-[#999999]">Prioridade</dt>
                        <dd class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-white">
                            @BriefingLabels.Priority(_task.Priority)
                        </dd>
                    </div>
                    <div>
                        <dt class="text-[13px] font-medium text-[#999999]">Responsável</dt>
                        <dd class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-white">
                            @(_task.DesignerName ?? (_task.DesignerId is null ? "Não atribuída" : "—"))
                        </dd>
                    </div>
                </dl>
            </div>

            <section class="mt-[20px] rounded-[20px] border border-[#262626] bg-[#141414]">
                <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[#262626] px-[30px] py-[20px]">
                    <h2 class="text-[22px] font-bold leading-[1.2] tracking-[-0.8px] text-white">Entregas</h2>
                    <p class="text-[13px] font-medium text-[#999999]">@_task.Deliveries.Count arquivo(s)</p>
                </div>

                @if (_task.Deliveries.Count == 0)
                {
                    <p class="px-[30px] py-[30px] text-[15px] text-[#999999]">
                        Nenhum arquivo entregue nesta tarefa ainda.
                    </p>
                }
                else
                {
                    <ul class="flex flex-col">
                        @foreach (var delivery in _task.Deliveries)
                        {
                            <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[#1a1a1a] px-[30px] py-[15px] last:border-b-0">
                                <div>
                                    <p class="text-[15px] leading-[1.3] tracking-[-0.15px] text-white">@delivery.FileName</p>
                                    @* RF052: a delivery is only readable if it says who produced it and when. *@
                                    <p class="mt-1 text-[13px] font-medium tracking-[-0.13px] text-[#999999]">
                                        @(delivery.UploadedByName ?? "—") • @delivery.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                </div>
                                <p class="text-[13px] font-medium text-[#999999]">@FormatSize(delivery.SizeBytes)</p>
                            </li>
                        }
                    </ul>
                }

                <AuthorizePermission Permission="tasks.deliver">
                    <div class="flex flex-col gap-[12px] border-t border-[#262626] px-[30px] py-[20px]">
                        <label for="delivery" class="text-[13px] font-medium text-[#999999]">Enviar novo arquivo</label>
                        <InputFile id="delivery" OnChange="OnFileSelectedAsync" disabled="@_isUploading"
                                   class="text-[14px] text-[#999999] file:mr-3 file:cursor-pointer file:rounded-[100px] file:border-0 file:bg-[#1c1c1c] file:px-[15px] file:py-[10px] file:text-[14px] file:font-medium file:text-white hover:file:bg-[#262626]" />

                        @if (_selectedFileName is not null)
                        {
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <p class="text-[14px] text-white">@_selectedFileName</p>
                                <button type="button" @onclick="UploadAsync" disabled="@(!CanUpload)"
                                        class="inline-flex items-center gap-2 rounded-[100px] bg-white px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-black transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60">
                                    @if (_isUploading)
                                    {
                                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-black/30 border-t-black"></span>
                                        <span>Enviando...</span>
                                    }
                                    else
                                    {
                                        <span>Enviar entrega</span>
                                    }
                                </button>
                            </div>
                        }

                        @if (_deliveryError is not null)
                        {
                            <div role="alert" class="rounded-[10px] border border-[#ef4444]/30 bg-[#ef4444]/10 px-[14px] py-[10px] text-[14px] text-[#ef4444]">
                                @_deliveryError
                            </div>
                        }
                    </div>
                </AuthorizePermission>
            </section>

            <section class="mt-[20px] rounded-[20px] border border-[#262626] bg-[#141414]">
                <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[#262626] px-[30px] py-[20px]">
                    <h2 class="text-[22px] font-bold leading-[1.2] tracking-[-0.8px] text-white">Comentários</h2>
                    <p class="text-[13px] font-medium text-[#999999]">@_task.Comments.Count comentário(s)</p>
                </div>

                @if (_task.Comments.Count == 0)
                {
                    <p class="px-[30px] py-[30px] text-[15px] text-[#999999]">
                        Nenhum comentário nesta tarefa ainda.
                    </p>
                }
                else
                {
                    <ul class="flex flex-col">
                        @foreach (var comment in _task.Comments)
                        {
                            <li class="border-b border-[#1a1a1a] px-[30px] py-[15px] last:border-b-0">
                                <p class="text-[13px] font-medium tracking-[-0.13px] text-[#999999]">
                                    @(comment.AuthorName ?? "—") • @comment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>
                                <p class="mt-1 whitespace-pre-line text-[15px] leading-[1.3] tracking-[-0.15px] text-white">
                                    @comment.Text
                                </p>
                            </li>
                        }
                    </ul>
                }

                <AuthorizePermission Permission="tasks.comment">
                    <div class="flex flex-col gap-[12px] border-t border-[#262626] px-[30px] py-[20px]">
                        <label for="comment" class="text-[13px] font-medium text-[#999999]">Novo comentário</label>
                        <textarea id="comment" rows="3" maxlength="@Comment.MaxTextLength"
                                  value="@_commentText" @oninput="OnCommentInput" disabled="@_isCommenting"
                                  class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white placeholder:text-[#999999] focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50"
                                  placeholder="Escreva para as pessoas envolvidas nesta tarefa."></textarea>

                        <div class="flex flex-wrap items-center justify-end gap-2">
                            <button type="button" @onclick="SubmitCommentAsync" disabled="@(!CanComment)"
                                    class="inline-flex items-center gap-2 rounded-[100px] bg-white px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-black transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60">
                                @if (_isCommenting)
                                {
                                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-black/30 border-t-black"></span>
                                    <span>Enviando...</span>
                                }
                                else
                                {
                                    <span>Comentar</span>
                                }
                            </button>
                        </div>

                        @if (_commentError is not null)
                        {
                            <div role="alert" class="rounded-[10px] border border-[#ef4444]/30 bg-[#ef4444]/10 px-[14px] py-[10px] text-[14px] text-[#ef4444]">
                                @_commentError
                            </div>
                        }
                    </div>
                </AuthorizePermission>
            </section>
        }
    </div>
</div>

@code {
    /// <summary>The task being read. Comes from the route (BRF-034); the caller's right to read it is
    /// decided server-side, so nothing else travels with it.</summary>
    [Parameter, EditorRequired]
    public Guid TaskId { get; set; }

    private TaskDetailDto? _task;
    private bool _isLoading = true;
    private string? _loadError;
    private ErrorType? _loadErrorType;

    private string _commentText = string.Empty;
    private bool _isCommenting;
    private string? _commentError;

    private string? _selectedFileName;
    private byte[]? _selectedFileContent;
    private bool _isUploading;
    private string? _deliveryError;

    private long MaxUploadSizeBytes => FileStorageOptions.Value.MaxSizeBytes;

    protected override async Task OnInitializedAsync()
    {
        // No interactive circuit during prerender means no restored token yet — the call would go out
        // anonymous. Same guard as TaskBoard.razor / Briefings.razor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        _loadErrorType = null;
        StateHasChanged();

        var result = await TasksApi.GetTaskAsync(TaskId);

        if (result.IsSuccess)
        {
            _task = result.Value;
        }
        else
        {
            _task = null;
            _loadError = result.Error;
            _loadErrorType = result.Type;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private string LoadFailureTitle => _loadErrorType switch
    {
        ErrorType.NotFound => "Tarefa não encontrada",
        ErrorType.Forbidden => "Acesso não permitido",
        _ => "Não foi possível carregar a tarefa"
    };

    private bool CanComment => !_isCommenting && !string.IsNullOrWhiteSpace(_commentText);

    private void OnCommentInput(ChangeEventArgs args) => _commentText = args.Value?.ToString() ?? string.Empty;

    private async Task SubmitCommentAsync()
    {
        if (!CanComment)
            return;

        _isCommenting = true;
        _commentError = null;

        var result = await TasksApi.RegisterCommentAsync(TaskId, _commentText);

        _isCommenting = false;

        if (result.IsFailure)
        {
            _commentError = FirstMessage(result);
            StateHasChanged();
            return;
        }

        // Re-read instead of appending: the trail on the server is the one that counts, and one query for a
        // page this size is cheaper than a local copy that can disagree with it.
        _commentText = string.Empty;
        await LoadAsync();
    }

    private bool CanUpload => !_isUploading && _selectedFileContent is not null;

    /// <summary>
    /// Buffers the picked file so the request body can be rebuilt if the token refresh replays it
    /// (<c>AuthenticatedApiClient.PostAsync</c>). The cap is the same <c>FileStorage:MaxSizeBytes</c> the
    /// server validates against (BRF-011), so an oversized file is refused here with the same limit rather
    /// than after a full upload.
    /// </summary>
    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _deliveryError = null;
        _selectedFileName = null;
        _selectedFileContent = null;

        var file = args.File;
        if (file is null)
            return;

        try
        {
            using var buffer = new MemoryStream();
            await using var content = file.OpenReadStream(MaxUploadSizeBytes);
            await content.CopyToAsync(buffer);

            _selectedFileName = file.Name;
            _selectedFileContent = buffer.ToArray();
        }
        catch (IOException)
        {
            // Thrown by OpenReadStream when the file is larger than the allowed size.
            _deliveryError = $"O arquivo excede o tamanho máximo de {FormatSize(MaxUploadSizeBytes)}.";
        }
    }

    private async Task UploadAsync()
    {
        if (!CanUpload)
            return;

        _isUploading = true;
        _deliveryError = null;

        var result = await TasksApi.SubmitDeliveryAsync(TaskId, _selectedFileName!, _selectedFileContent!);

        _isUploading = false;

        if (result.IsFailure)
        {
            _deliveryError = FirstMessage(result);
            StateHasChanged();
            return;
        }

        _selectedFileName = null;
        _selectedFileContent = null;
        await LoadAsync();
    }

    /// <summary>
    /// The message to show for a failed call: a field-keyed validation error when the API sent one
    /// (400 from a validator), otherwise the general failure detail.
    /// </summary>
    private static string? FirstMessage(Result result) =>
        result.Errors.Count > 0 ? result.Errors[0].ErrorMessage : result.Error;

    private static string FormatSize(long sizeBytes) => sizeBytes switch
    {
        >= 1024 * 1024 => $"{sizeBytes / (1024d * 1024d):0.#} MB",
        >= 1024 => $"{sizeBytes / 1024d:0.#} KB",
        _ => $"{sizeBytes} B"
    };
}
