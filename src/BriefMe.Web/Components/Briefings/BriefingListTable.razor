@*
    Tabela de briefings compartilhada pelas três listas (meus briefings, fila e meu trabalho). Cuida de
    carregando/erro/vazio e da paginação; cada página decide colunas opcionais e as ações da linha.
*@
@using BriefMe.Application.Common.Dtos
@using BriefMe.Web.Contracts.Common

<div class="overflow-hidden rounded-[20px] border border-[#262626] bg-[#141414]">
    @if (IsLoading)
    {
        <div class="flex items-center justify-center gap-3 py-24 text-[15px] text-[#999999]">
            <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
            <span>Carregando briefings...</span>
        </div>
    }
    else if (ErrorMessage is not null)
    {
        <div class="flex flex-col items-center justify-center gap-3 py-24 text-center">
            <p class="text-[15px] text-[#ef4444]">@ErrorMessage</p>
            <button type="button" @onclick="OnRetry"
                    class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                Tentar novamente
            </button>
        </div>
    }
    else if (Page is null || Page.Items.Count == 0)
    {
        <div class="flex flex-col items-center justify-center gap-1 py-24 text-center">
            <p class="text-[15px] text-white">@EmptyTitle</p>
            <p class="text-[14px] text-[#999999]">@EmptyHint</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full min-w-[860px] border-collapse text-left">
                <thead>
                    <tr class="border-b border-[#262626] text-[13px] font-medium text-[#999999]">
                        <th class="px-[20px] py-[14px]">Título</th>
                        <th class="px-[20px] py-[14px]">Status</th>
                        <th class="px-[20px] py-[14px]">Prioridade</th>
                        <th class="px-[20px] py-[14px]">Categoria</th>
                        @if (ShowRequester)
                        {
                            <th class="px-[20px] py-[14px]">Solicitante</th>
                        }
                        @if (ShowDesigner)
                        {
                            <th class="px-[20px] py-[14px]">Designer</th>
                        }
                        <th class="px-[20px] py-[14px]">Entrega desejada</th>
                        <th class="px-[20px] py-[14px] text-right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var briefing in Page.Items)
                    {
                        <tr class="border-b border-[#1a1a1a] text-[15px] last:border-b-0">
                            <td class="px-[20px] py-[14px] text-white">@briefing.Title</td>
                            <td class="px-[20px] py-[14px]">
                                <span class="inline-flex items-center rounded-[100px] px-[10px] py-[4px] text-[13px] font-medium @BriefingLabels.StatusBadgeClass(briefing.Status)">
                                    @BriefingLabels.Status(briefing.Status)
                                </span>
                            </td>
                            <td class="px-[20px] py-[14px] text-[#999999]">@BriefingLabels.Priority(briefing.Priority)</td>
                            <td class="px-[20px] py-[14px] text-[#999999]">@(briefing.CategoryName ?? "—")</td>
                            @if (ShowRequester)
                            {
                                <td class="px-[20px] py-[14px] text-[#999999]">@(briefing.RequesterName ?? "—")</td>
                            }
                            @if (ShowDesigner)
                            {
                                <td class="px-[20px] py-[14px] text-[#999999]">@(briefing.DesignerName ?? "—")</td>
                            }
                            <td class="px-[20px] py-[14px] text-[#999999]">
                                @(briefing.DesiredDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            <td class="px-[20px] py-[14px] text-right">
                                <div class="flex items-center justify-end gap-3">
                                    @RowActions(briefing)
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[#262626] px-[20px] py-[14px]">
            <p class="text-[14px] text-[#999999]">
                Página @Page.Page de @Math.Max(Page.TotalPages, 1) • @Page.TotalCount briefing(s)
            </p>
            <div class="flex items-center gap-2">
                <button type="button" @onclick="() => OnPageChange.InvokeAsync(Page.Page - 1)" disabled="@(Page.Page <= 1)"
                        class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[8px] text-[14px] font-medium text-white transition hover:bg-[#262626] disabled:cursor-not-allowed disabled:opacity-40">
                    Anterior
                </button>
                <button type="button" @onclick="() => OnPageChange.InvokeAsync(Page.Page + 1)" disabled="@(Page.Page >= Page.TotalPages)"
                        class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[8px] text-[14px] font-medium text-white transition hover:bg-[#262626] disabled:cursor-not-allowed disabled:opacity-40">
                    Próxima
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public PagedResponse<BriefingListItemDto>? Page { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool ShowRequester { get; set; }

    [Parameter]
    public bool ShowDesigner { get; set; }

    [Parameter]
    public string EmptyTitle { get; set; } = "Nenhum briefing encontrado";

    [Parameter]
    public string? EmptyHint { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<BriefingListItemDto> RowActions { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnPageChange { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
