@using BriefMe.Application.Common.Dtos
@using BriefMe.Application.UseCases.Briefings
@using BriefMe.Application.UseCases.Categories
@using BriefMe.Domain.Common
@using BriefMe.Domain.Enums
@using BriefMe.Web.Contracts.Briefings
@using System.ComponentModel.DataAnnotations
@inject IBriefingsApiClient BriefingsApi
@inject AuthSessionStore SessionStore
@inject NavigationManager NavigationManager

<PageContainer>
    <PageHeader Title="@Title" Description="@Subtitle" />

    <div class="mt-8">
        @if (_isLoading)
        {
            <Card>
                <LoadingState />
            </Card>
        }
        else if (_loadState is not null)
        {
            <Card>
                <EmptyState Title="@_loadState" Icon="IconName.FileText">
                    <Button Variant="ButtonVariant.Secondary" Icon="IconName.ArrowLeft" OnClick="NavigateAway">Voltar</Button>
                </EmptyState>
            </Card>
        }
        else
        {
            <Card>
                <EditForm EditContext="_editContext" FormName="briefingEditor" OnValidSubmit="HandleValidSubmitAsync"
                          class="grid gap-x-6 gap-y-5 p-6 sm:p-8 md:grid-cols-2">
                    <DataAnnotationsValidator />

                    @if (_generalError is not null)
                    {
                        <Alert Class="md:col-span-2">@_generalError</Alert>
                    }

                    <FormField Label="Título" For="title" Class="md:col-span-2">
                        <FormInput id="title" @bind-Value="_model.Title" disabled="@_isSubmitting" />
                        <FormMessage For="() => _model.Title" />
                    </FormField>

                    @if (IsEdit)
                    {
                        <FormField Label="Categoria" For="category" Description="A categoria é definida na criação e não pode ser alterada.">
                            <Input id="category" Value="@(_currentCategoryName ?? "—")" disabled />
                        </FormField>
                    }
                    else if (_categoriesUnavailable)
                    {
                        <FormField Label="Categoria" For="category">
                            <Input id="category" Value="Nenhuma categoria ativa disponível." aria-invalid="true" disabled />
                            <p class="text-caption text-error-ink">Não é possível criar um briefing sem uma categoria. Solicite a configuração de categorias.</p>
                        </FormField>
                    }
                    else
                    {
                        <FormField Label="Categoria" For="category">
                            <FormSelect id="category" TValue="Guid?" @bind-Value="_model.CategoryId" disabled="@_isSubmitting">
                                <option value="">Selecione uma categoria</option>
                                @foreach (var category in _categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </FormSelect>
                            <FormMessage For="() => _model.CategoryId" />
                        </FormField>
                    }

                    <FormField Label="Prioridade" For="priority">
                        <FormSelect id="priority" TValue="Priority" @bind-Value="_model.Priority" disabled="@_isSubmitting">
                            @foreach (var priority in PriorityOptions)
                            {
                                <option value="@priority.Value">@priority.Label</option>
                            }
                        </FormSelect>
                        <FormMessage For="() => _model.Priority" />
                    </FormField>

                    <FormField Label="Objetivo" For="objective" Class="md:col-span-2">
                        <FormTextarea id="objective" @bind-Value="_model.Objective" rows="3" disabled="@_isSubmitting" />
                    </FormField>

                    <FormField Label="Descrição" For="description" Class="md:col-span-2">
                        <FormTextarea id="description" @bind-Value="_model.Description" rows="4" disabled="@_isSubmitting" />
                    </FormField>

                    <FormField Label="Área solicitante" For="requestingArea">
                        <FormInput id="requestingArea" @bind-Value="_model.RequestingArea" disabled="@_isSubmitting" />
                    </FormField>

                    <FormField Label="Data desejada de entrega" For="deliveryDate">
                        <FormDateInput id="deliveryDate" TValue="DateOnly?" @bind-Value="_model.DesiredDeliveryDate" disabled="@_isSubmitting" />
                    </FormField>

                    <FormField Label="Anexos" For="attachments" Class="md:col-span-2">
                        <AttachmentPicker @ref="_attachmentPicker" Existing="_existingAttachments" BriefingId="BriefingId" Disabled="_isSubmitting" />
                    </FormField>

                    <div class="mt-2 flex flex-wrap items-center justify-end gap-2 md:col-span-2">
                        <Button Variant="ButtonVariant.Secondary" Icon="IconName.X" OnClick="NavigateAway" Disabled="_isSubmitting">Cancelar</Button>
                        <Button Type="submit" Variant="ButtonVariant.Outline" Icon="IconName.Save" OnClick="() => _pendingAction = SubmitAction.SaveDraft"
                                Disabled="@(_isSubmitting || _categoriesUnavailable)"
                                Loading="@(_isSubmitting && _pendingAction == SubmitAction.SaveDraft)">
                            @(_isSubmitting && _pendingAction == SubmitAction.SaveDraft ? "Salvando..." : "Salvar rascunho")
                        </Button>
                        <Button Type="submit" Icon="IconName.Send" OnClick="() => _pendingAction = SubmitAction.Submit"
                                Disabled="@(_isSubmitting || _categoriesUnavailable)"
                                Loading="@(_isSubmitting && _pendingAction == SubmitAction.Submit)">
                            @(_isSubmitting && _pendingAction == SubmitAction.Submit ? "Enviando..." : "Enviar para o design")
                        </Button>
                    </div>
                </EditForm>
            </Card>
        }
    </div>
</PageContainer>

@code {
    /// <summary>Null in create mode; the target briefing's id in edit mode.</summary>
    [Parameter]
    public Guid? BriefingId { get; set; }

    private static readonly (Priority Value, string Label)[] PriorityOptions =
    [
        (Priority.Low, "Baixa"),
        (Priority.Medium, "Média"),
        (Priority.High, "Alta"),
        (Priority.Urgent, "Urgente"),
    ];

    // Command property names an API validation failure can be keyed by (mirrors the model field names).
    private static readonly string[] FieldNames =
    [
        nameof(BriefingFormModel.Title),
        nameof(BriefingFormModel.CategoryId),
        nameof(BriefingFormModel.Priority),
    ];

    private enum SubmitAction { SaveDraft, Submit }

    private bool IsEdit => BriefingId.HasValue;
    private string Title => IsEdit ? "Editar briefing" : "Novo briefing";
    private string Subtitle => IsEdit ? "Atualize as informações do briefing." : "Preencha as informações para abrir um novo briefing.";

    private bool _isLoading = true;
    private string? _loadState;
    private bool _categoriesUnavailable;
    private string? _generalError;
    private bool _isSubmitting;
    private SubmitAction _pendingAction = SubmitAction.SaveDraft;

    private IReadOnlyList<CategoryListItemDto> _categories = [];
    private IReadOnlyList<BriefingAttachmentDto> _existingAttachments = [];
    private AttachmentPicker? _attachmentPicker;
    private string? _currentCategoryName;

    private BriefingFormModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;

    protected override async Task OnInitializedAsync()
    {
        // No token before the interactive restore — same guard as UserEditor / Users.razor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        _categories = await BriefingsApi.GetCategoriesAsync();

        if (IsEdit)
        {
            var result = await BriefingsApi.GetBriefingAsync(BriefingId!.Value);
            if (result.IsFailure)
            {
                _loadState = result.Type switch
                {
                    ErrorType.NotFound => "Briefing não encontrado",
                    ErrorType.Forbidden => "Você não tem acesso a este briefing",
                    _ => result.Error
                };
                _isLoading = false;
                return;
            }

            var briefing = result.Value;
            _model.Title = briefing.Title;
            _model.CategoryId = briefing.CategoryId;
            _model.Priority = briefing.Priority;
            _model.Objective = briefing.Objective;
            _model.Description = briefing.Description;
            _model.RequestingArea = briefing.RequestingArea;
            _model.DesiredDeliveryDate = briefing.DesiredDeliveryDate;
            _currentCategoryName = _categories.FirstOrDefault(c => c.Id == briefing.CategoryId)?.Name;
            _existingAttachments = briefing.Attachments;
        }
        else
        {
            // Create needs a category (RF040); without a catalog the form cannot proceed.
            _categoriesUnavailable = _categories.Count == 0;
            _model.RequireCategory = true;
        }

        InitializeEditContext();
        _isLoading = false;
    }

    private void InitializeEditContext()
    {
        _editContext = new EditContext(_model);
        _messageStore = new ValidationMessageStore(_editContext);
        // Clear a field's server-side message as soon as the user edits it, so stale API errors don't linger.
        _editContext.OnFieldChanged += (_, args) => _messageStore.Clear(args.FieldIdentifier);
    }

    private async Task HandleValidSubmitAsync()
    {
        _generalError = null;
        _messageStore.Clear();
        _isSubmitting = true;

        var newAttachments = _attachmentPicker?.Queued ?? [];
        var removedAttachmentIds = _attachmentPicker?.RemovedIds ?? [];

        var save = IsEdit
            ? await BriefingsApi.UpdateBriefingAsync(BriefingId!.Value, new UpdateBriefingRequest(
                _model.Title,
                _model.Priority,
                _model.Description,
                _model.Objective,
                _model.RequestingArea,
                _model.DesiredDeliveryDate), newAttachments, removedAttachmentIds)
            : await BriefingsApi.CreateBriefingAsync(new CreateBriefingRequest(
                _model.Title,
                _model.Priority,
                _model.CategoryId!.Value,
                _model.Description,
                _model.Objective,
                _model.RequestingArea,
                _model.DesiredDeliveryDate), newAttachments);

        if (save.IsFailure)
        {
            ApplyFailure(save);
            _isSubmitting = false;
            return;
        }

        if (_pendingAction == SubmitAction.Submit)
        {
            var submit = await BriefingsApi.SubmitBriefingAsync(save.Value.Id);
            if (submit.IsFailure)
            {
                // The save already applied the attachment changes; a retry must not upload or remove them again.
                if (IsEdit)
                    await RefreshAttachmentsAsync();

                // The draft was persisted; only the submit transition failed. Surface it and keep the form.
                ApplyFailure(submit);
                _isSubmitting = false;
                return;
            }
        }

        NavigateAway();
    }

    private async Task RefreshAttachmentsAsync()
    {
        _attachmentPicker?.Clear();

        var reloaded = await BriefingsApi.GetBriefingAsync(BriefingId!.Value);
        if (reloaded.IsSuccess)
            _existingAttachments = reloaded.Value.Attachments;
    }

    private void ApplyFailure(Result result)
    {
        if (result.Errors.Count == 0)
        {
            _generalError = result.Error;
            return;
        }

        var unmapped = new List<string>();
        foreach (var error in result.Errors)
        {
            if (FieldNames.Contains(error.PropertyName))
                _messageStore.Add(new FieldIdentifier(_model, error.PropertyName), error.ErrorMessage);
            else
                unmapped.Add(error.ErrorMessage);
        }

        _editContext.NotifyValidationStateChanged();

        if (unmapped.Count > 0)
            _generalError = string.Join(" ", unmapped);
    }

    // Back/after-save target: the requester's list (BRF-014), where the saved briefing is now visible.
    private void NavigateAway() => NavigationManager.NavigateTo("/briefings/meus");

    private sealed class BriefingFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Título é obrigatório.")]
        public string Title { get; set; } = string.Empty;

        public Guid? CategoryId { get; set; }

        public Priority Priority { get; set; } = Priority.Medium;

        public string? Objective { get; set; }

        public string? Description { get; set; }

        public string? RequestingArea { get; set; }

        public DateOnly? DesiredDeliveryDate { get; set; }

        /// <summary>True only in create mode — the category is fixed at creation and read-only on edit.</summary>
        public bool RequireCategory { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (RequireCategory && (CategoryId is null || CategoryId == Guid.Empty))
                yield return new ValidationResult("Categoria é obrigatória.", [nameof(CategoryId)]);

            if (!Enum.IsDefined(Priority))
                yield return new ValidationResult("Prioridade inválida.", [nameof(Priority)]);
        }
    }
}
