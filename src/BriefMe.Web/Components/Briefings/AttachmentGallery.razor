@*
    The "Anexos" section of a briefing (ATT-14/17): one row per kind — images, videos, PDFs, audio (AGK-01..04) —
    each titled with its count and laid out as a grid. Renders nothing when there are no attachments (AGK-05).
*@
@using BriefMe.Application.Common.Dtos
@using BriefMe.Domain.Enums

@if (Attachments.Count > 0)
{
    <Card Class="@ClassNames.Join("p-6", Class)">
        <div class="flex items-center gap-2">
            <Icon Name="IconName.Paperclip" Class="text-muted" />
            <CardTitle>Anexos (@Attachments.Count)</CardTitle>
        </div>

        @foreach (var group in _groups)
        {
            <section class="mt-5">
                <h3 class="text-body-sm font-semibold text-muted">@AttachmentLabels.KindPlural(group.Key) (@group.Count())</h3>
                <div class="@ClassNames.Join("mt-3 grid gap-4", GridColumns(group.Key))">
                    @foreach (var attachment in group)
                    {
                        <AttachmentPreview @key="attachment.Id" BriefingId="BriefingId" Attachment="attachment" OnReload="OnReload" />
                    }
                </div>
            </section>
        }
    </Card>
}

@code {
    [Parameter, EditorRequired]
    public Guid BriefingId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<BriefingAttachmentDto> Attachments { get; set; } = [];

    [Parameter]
    public EventCallback OnReload { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private IReadOnlyList<IGrouping<AttachmentKind, BriefingAttachmentDto>> _groups = [];

    protected override void OnParametersSet() => _groups = AttachmentLabels.GroupByKind(Attachments);

    // Players get wider cells than thumbnails and file cards.
    private static string GridColumns(AttachmentKind kind) =>
        kind is AttachmentKind.Audio or AttachmentKind.Video ? "lg:grid-cols-2" : "sm:grid-cols-2 lg:grid-cols-3";
}
