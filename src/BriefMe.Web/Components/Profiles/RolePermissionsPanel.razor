@using BriefMe.Application.Common.Dtos
@using BriefMe.Application.UseCases.Permissions
@using BriefMe.Application.UseCases.Roles
@using BriefMe.Domain.Common
@using BriefMe.Web.Contracts.Roles
@inject IRolesApiClient RolesApi

<div class="rounded-[20px] border border-[#262626] bg-[#141414]">
    @if (_isLoading)
    {
        <div class="flex items-center justify-center gap-3 py-24 text-[15px] text-[#999999]">
            <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
            <span>Carregando permissões...</span>
        </div>
    }
    else if (_notFound)
    {
        <div class="flex flex-col items-center justify-center gap-1 py-24 text-center">
            <p class="text-[15px] text-white">Perfil não encontrado</p>
            <p class="text-[14px] text-[#999999]">Ele pode ter sido removido. Selecione outro perfil.</p>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="flex flex-col items-center justify-center gap-3 py-24 text-center">
            <p class="text-[15px] text-[#ef4444]">@_loadError</p>
            <button type="button" @onclick="ReloadAsync"
                    class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                Tentar novamente
            </button>
        </div>
    }
    else
    {
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-[#262626] px-[30px] py-[20px]">
            <div>
                <div class="flex items-center gap-2">
                    <h2 class="text-[22px] font-bold leading-[1.2] tracking-[-0.8px] text-white">@Role.Name</h2>
                    @if (Role.IsSystemRole)
                    {
                        <span class="inline-flex items-center rounded-[100px] bg-[#1c1c1c] px-[10px] py-[4px] text-[13px] font-medium text-[#999999]">Sistema</span>
                    }
                </div>
                <p class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
                    @(string.IsNullOrWhiteSpace(Role.Description) ? "Sem descrição." : Role.Description)
                </p>
            </div>

            <p class="text-[14px] font-medium tracking-[-0.14px] text-[#999999]">
                @_selectedPermissionIds.Count de @TotalPermissions permissões
            </p>
        </div>

        @if (_saveError is not null)
        {
            <div role="alert" class="mx-[30px] mt-[20px] rounded-[10px] border border-[#ef4444]/30 bg-[#ef4444]/10 px-[14px] py-[10px] text-[14px] text-[#ef4444]">
                @_saveError
            </div>
        }
        else if (_savedMessage is not null)
        {
            <div role="status" class="mx-[30px] mt-[20px] rounded-[10px] border border-[#22c55e]/30 bg-[#22c55e]/10 px-[14px] py-[10px] text-[14px] text-[#22c55e]">
                @_savedMessage
            </div>
        }

        <div class="flex flex-col gap-[30px] px-[30px] py-[20px]">
            @foreach (var group in PermissionGroups)
            {
                <section class="flex flex-col gap-[12px]">
                    <h3 class="text-[13px] font-medium uppercase tracking-[-0.13px] text-[#999999]">@group.Group</h3>

                    <div class="flex flex-col gap-2 rounded-[10px] border border-[#262626] bg-[#1c1c1c] p-[14px]">
                        @foreach (var permission in group.Permissions)
                        {
                            <label class="flex items-start gap-3 text-[15px] leading-[1.3] tracking-[-0.15px] text-white">
                                <input type="checkbox" checked="@_selectedPermissionIds.Contains(permission.PermissionId)"
                                       disabled="@_isSaving"
                                       @onchange="e => TogglePermission(permission.PermissionId, (bool)e.Value!)"
                                       class="mt-[3px] h-4 w-4 rounded border-[#262626] bg-[#141414] accent-[#0099ff]" />
                                <span class="flex flex-col">
                                    <span>@permission.Name</span>
                                    <span class="text-[13px] font-medium tracking-[-0.13px] text-[#999999]">@permission.Code</span>
                                </span>
                            </label>
                        }
                    </div>
                </section>
            }
        </div>

        <div class="flex flex-wrap items-center justify-end gap-2 border-t border-[#262626] px-[30px] py-[20px]">
            <button type="button" @onclick="ResetSelection" disabled="@(_isSaving || !IsDirty)"
                    class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-white transition hover:bg-[#262626] disabled:cursor-not-allowed disabled:opacity-40">
                Descartar
            </button>
            <button type="button" @onclick="SaveAsync" disabled="@(_isSaving || !IsDirty)"
                    class="inline-flex items-center gap-2 rounded-[100px] bg-white px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-black transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40">
                @if (_isSaving)
                {
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-black/30 border-t-black"></span>
                    <span>Salvando...</span>
                }
                else
                {
                    <span>Salvar permissões</span>
                }
            </button>
        </div>
    }
</div>

@code {
    /// <summary>The role selected in the master list.</summary>
    [Parameter, EditorRequired]
    public RoleListItemDto Role { get; set; } = default!;

    /// <summary>
    /// The permission catalog, already loaded by the page. Owning it there keeps <c>GET /permissions</c>
    /// to a single call per visit and lets the page fail closed when the catalog is unavailable (USRROLE-11).
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<PermissionGroupDto> PermissionGroups { get; set; } = [];

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _notFound;
    private string? _loadError;
    private string? _saveError;
    private string? _savedMessage;

    private Guid? _loadedRoleId;
    private HashSet<Guid> _selectedPermissionIds = [];
    private HashSet<Guid> _persistedPermissionIds = [];

    private int TotalPermissions => PermissionGroups.Sum(group => group.Permissions.Count);

    private bool IsDirty => !_selectedPermissionIds.SetEquals(_persistedPermissionIds);

    protected override async Task OnParametersSetAsync()
    {
        // Reload only when the selection actually changes — re-renders of the same role keep the
        // operator's unsaved toggles.
        if (_loadedRoleId == Role.RoleId)
            return;

        _loadedRoleId = Role.RoleId;
        await LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _notFound = false;
        _loadError = null;
        _saveError = null;
        _savedMessage = null;

        var result = await RolesApi.GetRoleAsync(Role.RoleId);

        if (result.IsSuccess)
        {
            _persistedPermissionIds = MapCodesToIds(result.Value.PermissionCodes);
            _selectedPermissionIds = [.. _persistedPermissionIds];
        }
        else if (result.Type == ErrorType.NotFound)
        {
            _notFound = true;
        }
        else
        {
            _loadError = result.Error;
        }

        _isLoading = false;
    }

    /// <summary>
    /// <c>GET /roles/{id}</c> returns permission <em>codes</em>; the update command consumes ids. Codes are
    /// unique (USR-007), so the catalog is the bridge. A code missing from the catalog is ignored rather
    /// than blocking the editor.
    /// </summary>
    private HashSet<Guid> MapCodesToIds(IReadOnlyCollection<string> codes) =>
        PermissionGroups
            .SelectMany(group => group.Permissions)
            .Where(permission => codes.Contains(permission.Code))
            .Select(permission => permission.PermissionId)
            .ToHashSet();

    private void TogglePermission(Guid permissionId, bool selected)
    {
        if (selected)
            _selectedPermissionIds.Add(permissionId);
        else
            _selectedPermissionIds.Remove(permissionId);

        _saveError = null;
        _savedMessage = null;
    }

    private void ResetSelection()
    {
        _selectedPermissionIds = [.. _persistedPermissionIds];
        _saveError = null;
        _savedMessage = null;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _saveError = null;
        _savedMessage = null;

        var request = new UpdateRolePermissionsRequest(_selectedPermissionIds.ToList());
        var result = await RolesApi.UpdateRolePermissionsAsync(Role.RoleId, request);

        if (result.IsSuccess)
        {
            // Re-seed from the persisted state, so the dirty check reflects what the server actually stored.
            _persistedPermissionIds = MapCodesToIds(result.Value.PermissionCodes);
            _selectedPermissionIds = [.. _persistedPermissionIds];
            _savedMessage = "Permissões atualizadas.";
        }
        else
        {
            // Keep the operator's toggles on failure so nothing is retyped (USRROLE-09).
            _saveError = result.Errors.Count > 0
                ? string.Join(" ", result.Errors.Select(error => error.ErrorMessage))
                : result.Error;
        }

        _isSaving = false;
    }
}
