@*
    Card de navegação da Home. Renderiza apenas para o perfil informado.
*@

<AuthorizeView Roles="@Role.ToString()" Context="_">
    <a href="@Href" class="group block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        <Card Class="flex h-full flex-col gap-2 p-6 transition-colors group-hover:border-primary group-hover:bg-band-blue">
            <CardTitle Class="group-hover:text-primary">@Title</CardTitle>
            <CardDescription>@Description</CardDescription>
        </Card>
    </a>
</AuthorizeView>

@code {
    [Parameter, EditorRequired]
    public required UserRole Role { get; set; }

    [Parameter, EditorRequired]
    public required string Href { get; set; }

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required string Description { get; set; }
}
