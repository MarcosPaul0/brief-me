@*
    Grade de opções de navegação da Home. Cada card se auto-oculta conforme a policy.
*@

<div class="mt-[30px] grid gap-[20px] sm:grid-cols-2 lg:grid-cols-3">
    <NavOptionCard Policy="briefings.view-own"
                   Href="briefings/meus"
                   Title="Meus briefings"
                   Description="Acompanhe o andamento das suas solicitações de design." />

    <NavOptionCard Policy="briefings.create"
                   Href="briefings/novo"
                   Title="Novo briefing"
                   Description="Abra uma nova solicitação para o time de design." />

    <NavOptionCard Policy="briefings.view-all"
                   Href="briefings/aprovacoes"
                   Title="Aprovações pendentes"
                   Description="Revise, aprove ou devolva os briefings aguardando aprovação." />

    <NavOptionCard Policy="tasks.view-assigned"
                   Href="tarefas"
                   Title="Minhas tarefas"
                   Description="Trabalhe as tarefas atribuídas a você, do prazo mais próximo em diante." />

    <NavOptionCard Policy="tasks.view-all,briefings.view-all"
                   Href="sla/atrasos"
                   Title="Atrasos e SLA"
                   Description="Veja quantas tarefas e briefings passaram do prazo, e quais são." />

    <NavOptionCard Policy="users.view"
                   Href="usuarios"
                   Title="Usuários"
                   Description="Cadastre, edite e gerencie os usuários do sistema." />

    <NavOptionCard Policy="roles.manage"
                   Href="perfis"
                   Title="Perfis"
                   Description="Gerencie os perfis de acesso e suas permissões." />

    <NavOptionCard Policy="permissions.manage"
                   Href="permissoes"
                   Title="Permissões"
                   Description="Consulte o catálogo de permissões do sistema." />
</div>
