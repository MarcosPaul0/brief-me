@* BRF-033 (RF017–RF020) — the Designer's own work plan.
   Route note: the Blazor screen lives at /tarefas because @page "/tasks" would collide with
   TasksController's [Route("tasks")] GET (AmbiguousMatchException — the USR-042 bug). *@
@page "/tarefas"
@attribute [Authorize(Policy = "tasks.view-assigned")]
@using BriefMe.Application.Common.Dtos
@using BriefMe.Domain.Enums
@using BriefMe.Web.Contracts.Common
@using Microsoft.AspNetCore.Authorization
@inject ITasksApiClient TasksApi
@inject AuthSessionStore SessionStore

<PageTitle>Minhas tarefas</PageTitle>

<div class="min-h-full bg-[#090909] px-4 py-8 text-white sm:px-8">
    <div class="mx-auto max-w-[1100px]">
        <div>
            <h1 class="text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">Minhas tarefas</h1>
            <p class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
                Suas tarefas de design, do prazo mais próximo ao mais distante.
            </p>
        </div>

        <form @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault="true"
              class="mt-[30px] flex flex-wrap items-end gap-[12px]">
            <div class="flex flex-col gap-1">
                <label for="status" class="text-[13px] font-medium text-[#999999]">Status</label>
                <select id="status" @bind="_statusFilter"
                        class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none">
                    <option value="">Todos</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status.ToString()">@StatusLabel(status)</option>
                    }
                </select>
            </div>

            <div class="flex flex-col gap-1">
                <label for="priority" class="text-[13px] font-medium text-[#999999]">Prioridade</label>
                <select id="priority" @bind="_priorityFilter"
                        class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none">
                    <option value="">Todas</option>
                    @foreach (var priority in PriorityOptions)
                    {
                        <option value="@priority.ToString()">@PriorityLabel(priority)</option>
                    }
                </select>
            </div>

            <button type="submit"
                    class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-white transition hover:bg-[#262626]">
                Aplicar
            </button>
        </form>

        @if (_actionError is not null)
        {
            <div role="alert" class="mt-[20px] rounded-[10px] border border-[#ef4444]/30 bg-[#ef4444]/10 px-[14px] py-[10px] text-[14px] text-[#ef4444]">
                @_actionError
            </div>
        }

        <div class="mt-[20px] overflow-hidden rounded-[20px] border border-[#262626] bg-[#141414]">
            @if (_isLoading)
            {
                <div class="flex items-center justify-center gap-3 py-24 text-[15px] text-[#999999]">
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
                    <span>Carregando tarefas...</span>
                </div>
            }
            else if (_errorMessage is not null)
            {
                <div class="flex flex-col items-center justify-center gap-3 py-24 text-center">
                    <p class="text-[15px] text-[#ef4444]">@_errorMessage</p>
                    <button type="button" @onclick="ReloadAsync"
                            class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                        Tentar novamente
                    </button>
                </div>
            }
            else if (_page is null || _page.Items.Count == 0)
            {
                <div class="flex flex-col items-center justify-center gap-1 py-24 text-center">
                    <p class="text-[15px] text-white">Nenhuma tarefa encontrada</p>
                    <p class="text-[14px] text-[#999999]">Ajuste os filtros ou aguarde uma nova atribuição.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[860px] border-collapse text-left">
                        <thead>
                            <tr class="border-b border-[#262626] text-[13px] font-medium text-[#999999]">
                                <th class="px-[20px] py-[14px]">Tarefa</th>
                                <th class="px-[20px] py-[14px]">Briefing</th>
                                <th class="px-[20px] py-[14px]">Status</th>
                                <th class="px-[20px] py-[14px]">Prioridade</th>
                                <th class="px-[20px] py-[14px]">Prazo</th>
                                <th class="px-[20px] py-[14px] text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in _page.Items)
                            {
                                <tr class="border-b border-[#1a1a1a] text-[15px] last:border-b-0 @RowClass(task.Status)">
                                    <td class="px-[20px] py-[14px]">
                                        @* The row is the index entry; its record — comments, entregas, prazo — is BRF-034. *@
                                        <a href="/tarefas/@task.Id" class="text-white transition hover:text-[#0099ff]">@task.Title</a>
                                    </td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">@(task.BriefingTitle ?? "—")</td>
                                    <td class="px-[20px] py-[14px]">
                                        <span class="inline-flex items-center rounded-[100px] px-[10px] py-[4px] text-[13px] font-medium @StatusBadgeClass(task.Status)">
                                            @StatusLabel(task.Status)
                                        </span>
                                    </td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">@PriorityLabel(task.Priority)</td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">
                                        @(task.Deadline?.ToString("dd/MM/yyyy") ?? "—")
                                    </td>
                                    <td class="px-[20px] py-[14px] text-right">
                                        <AuthorizePermission Permission="tasks.update-status">
                                            <div class="flex items-center justify-end gap-3">
                                                @if (CanStart(task.Status))
                                                {
                                                    <button type="button" @onclick="() => MoveAsync(task, BriefingTaskStatus.InProgress)" disabled="@IsBusy(task)"
                                                            class="text-[14px] font-medium text-[#0099ff] transition hover:underline disabled:cursor-not-allowed disabled:text-[#999999] disabled:no-underline">
                                                        Iniciar
                                                    </button>
                                                }
                                                @if (CanResume(task.Status))
                                                {
                                                    <button type="button" @onclick="() => MoveAsync(task, BriefingTaskStatus.InProgress)" disabled="@IsBusy(task)"
                                                            class="text-[14px] font-medium text-[#0099ff] transition hover:underline disabled:cursor-not-allowed disabled:text-[#999999] disabled:no-underline">
                                                        Retomar
                                                    </button>
                                                }
                                                @if (CanBlock(task.Status))
                                                {
                                                    <button type="button" @onclick="() => MoveAsync(task, BriefingTaskStatus.Blocked)" disabled="@IsBusy(task)"
                                                            class="text-[14px] font-medium text-[#0099ff] transition hover:underline disabled:cursor-not-allowed disabled:text-[#999999] disabled:no-underline">
                                                        Bloquear
                                                    </button>
                                                }
                                                @if (!HasAnyAction(task.Status))
                                                {
                                                    <span class="text-[14px] text-[#999999]">—</span>
                                                }
                                            </div>
                                        </AuthorizePermission>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[#262626] px-[20px] py-[14px]">
                    <p class="text-[14px] text-[#999999]">
                        Página @_page.Page de @Math.Max(_page.TotalPages, 1) • @_page.TotalCount tarefa(s)
                    </p>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousPageAsync" disabled="@(!CanGoPrevious)"
                                class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[8px] text-[14px] font-medium text-white transition hover:bg-[#262626] disabled:cursor-not-allowed disabled:opacity-40">
                            Anterior
                        </button>
                        <button type="button" @onclick="NextPageAsync" disabled="@(!CanGoNext)"
                                class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[8px] text-[14px] font-medium text-white transition hover:bg-[#262626] disabled:cursor-not-allowed disabled:opacity-40">
                            Próxima
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private const int PageSize = 20;

    private static readonly BriefingTaskStatus[] StatusOptions = Enum.GetValues<BriefingTaskStatus>();

    private static readonly Priority[] PriorityOptions = Enum.GetValues<Priority>();

    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _actionError;
    private PagedResponse<DesignerTaskDto>? _page;

    private int _currentPage = 1;
    private string _statusFilter = string.Empty;
    private string _priorityFilter = string.Empty;

    /// <summary>The task whose status change is in flight — only its own actions disable while it runs.</summary>
    private Guid? _movingTaskId;

    protected override async Task OnInitializedAsync()
    {
        // No interactive circuit during prerender means no restored token yet — the call would go out
        // anonymous. Same guard as Briefings.razor / Users.razor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        // A filter change restarts from page 1 so a shrinking result set never leaves the view out of range.
        _currentPage = 1;
        await LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var query = new TaskListQuery(
            Page: _currentPage,
            PageSize: PageSize,
            Status: ParseStatus(_statusFilter),
            Priority: ParsePriority(_priorityFilter));

        var result = await TasksApi.GetMyTasksAsync(query);

        if (result.IsSuccess)
        {
            _page = result.Value;
            _currentPage = _page.Page;
        }
        else
        {
            _page = null;
            _errorMessage = result.Error;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private bool CanGoPrevious => _page is { Page: > 1 };

    private bool CanGoNext => _page is not null && _page.Page < _page.TotalPages;

    private async Task PreviousPageAsync()
    {
        if (!CanGoPrevious)
            return;

        _currentPage = _page!.Page - 1;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!CanGoNext)
            return;

        _currentPage = _page!.Page + 1;
        await LoadAsync();
    }

    private bool IsBusy(DesignerTaskDto task) => _movingTaskId == task.Id;

    private async Task MoveAsync(DesignerTaskDto task, BriefingTaskStatus status)
    {
        _actionError = null;
        _movingTaskId = task.Id;

        var result = await TasksApi.UpdateTaskStatusAsync(task.Id, status);

        _movingTaskId = null;

        // On failure the reload still runs: the row's real status is what makes a stale action correct itself.
        _actionError = result.IsFailure ? result.Error : null;

        await LoadAsync();
    }

    // The three guards below are the edges that are both in the RF020 table (BriefingTask.AllowedTransitions)
    // and reachable through UpdateTaskStatusCommand, which only opens the execution states. Submitting a
    // delivery for technical approval is BRF-066 and has no affordance here yet. Keep in sync with both.
    private static bool CanStart(BriefingTaskStatus status) =>
        status is BriefingTaskStatus.NotStarted;

    private static bool CanResume(BriefingTaskStatus status) =>
        status is BriefingTaskStatus.Blocked or BriefingTaskStatus.Rejected;

    private static bool CanBlock(BriefingTaskStatus status) =>
        status is BriefingTaskStatus.NotStarted or BriefingTaskStatus.InProgress;

    private static bool HasAnyAction(BriefingTaskStatus status) =>
        CanStart(status) || CanResume(status) || CanBlock(status);

    private static BriefingTaskStatus? ParseStatus(string value) =>
        Enum.TryParse<BriefingTaskStatus>(value, out var status) ? status : null;

    private static Priority? ParsePriority(string value) =>
        Enum.TryParse<Priority>(value, out var priority) ? priority : null;

    // Labels live in BriefingTaskLabels so this screen and the task detail (BRF-034) translate the enum once;
    // Priority reuses BriefingLabels — same domain enum the briefing screens already translate.
    private static string StatusLabel(BriefingTaskStatus status) => BriefingTaskLabels.Status(status);

    private static string StatusBadgeClass(BriefingTaskStatus status) => BriefingTaskLabels.StatusBadgeClass(status);

    private static string RowClass(BriefingTaskStatus status) => BriefingTaskLabels.RowClass(status);

    private static string PriorityLabel(Priority priority) => BriefingLabels.Priority(priority);
}
