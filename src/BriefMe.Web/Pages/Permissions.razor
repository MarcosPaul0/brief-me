@page "/permissoes"
@attribute [Authorize(Policy = "permissions.manage")]
@using BriefMe.Application.Common.Dtos
@using BriefMe.Application.UseCases.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IPermissionsApiClient PermissionsApi
@inject AuthSessionStore SessionStore

<PageTitle>Permissões</PageTitle>

<div class="min-h-full bg-[#090909] px-4 py-8 text-white sm:px-8">
    <div class="mx-auto max-w-[1100px]">
        <div>
            <h1 class="text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">Permissões</h1>
            <p class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
                Catálogo de permissões do sistema, agrupado por módulo. Somente leitura — as permissões são
                definidas na carga inicial e associadas aos perfis em <a href="/perfis" class="text-[#0099ff] hover:underline">Perfis</a>.
            </p>
        </div>

        @if (_isLoading)
        {
            <div class="mt-[30px] flex items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-[15px] text-[#999999]">
                <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
                <span>Carregando permissões...</span>
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="mt-[30px] flex flex-col items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-center">
                <p class="text-[15px] text-[#ef4444]">@_errorMessage</p>
                <button type="button" @onclick="LoadAsync"
                        class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                    Tentar novamente
                </button>
            </div>
        }
        else if (_groups.Count == 0)
        {
            <div class="mt-[30px] flex flex-col items-center justify-center gap-1 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-center">
                <p class="text-[15px] text-white">Nenhuma permissão cadastrada</p>
                <p class="text-[14px] text-[#999999]">O catálogo é criado na carga inicial do sistema.</p>
            </div>
        }
        else
        {
            <p class="mt-[30px] text-[14px] font-medium tracking-[-0.14px] text-[#999999]">
                @TotalPermissions permissões em @_groups.Count módulo(s)
            </p>

            <div class="mt-[12px] flex flex-col gap-[20px]">
                @foreach (var group in _groups)
                {
                    <section class="overflow-hidden rounded-[20px] border border-[#262626] bg-[#141414]">
                        <div class="flex items-baseline justify-between gap-3 border-b border-[#262626] px-[20px] py-[14px]">
                            <h2 class="text-[22px] font-bold leading-[1.2] tracking-[-0.8px] text-white">@group.Group</h2>
                            <span class="text-[13px] font-medium tracking-[-0.13px] text-[#999999]">@group.Permissions.Count permissão(ões)</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full min-w-[640px] border-collapse text-left">
                                <thead>
                                    <tr class="border-b border-[#262626] text-[13px] font-medium text-[#999999]">
                                        <th class="px-[20px] py-[14px]">Código</th>
                                        <th class="px-[20px] py-[14px]">Nome</th>
                                        <th class="px-[20px] py-[14px]">Descrição</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var permission in group.Permissions)
                                    {
                                        <tr class="border-b border-[#1a1a1a] text-[15px] last:border-b-0">
                                            <td class="px-[20px] py-[14px] text-white">@permission.Code</td>
                                            <td class="px-[20px] py-[14px] text-[#999999]">@permission.Name</td>
                                            <td class="px-[20px] py-[14px] text-[#999999]">
                                                @(string.IsNullOrWhiteSpace(permission.Description) ? "—" : permission.Description)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private IReadOnlyList<PermissionGroupDto> _groups = [];

    private int TotalPermissions => _groups.Sum(group => group.Permissions.Count);

    protected override async Task OnInitializedAsync()
    {
        // No interactive circuit during prerender means no restored token yet; the API call would go out
        // anonymous. Wait for the interactive pass and the session restore (same as Users.razor).
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await PermissionsApi.GetPermissionGroupsAsync();

        if (result.IsSuccess)
            _groups = result.Value;
        else
            _errorMessage = result.Error;

        _isLoading = false;
        StateHasChanged();
    }
}
