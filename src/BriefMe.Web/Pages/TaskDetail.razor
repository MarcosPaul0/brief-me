@* BRF-034 (RF021, RF022, RF052) — the detail of a single task.
   Route note: it lives under /tarefas for the same reason the board does — @page "/tasks/{id}" would
   collide with TasksController's new [HttpGet("{id:guid}")] (AmbiguousMatchException, the USR-042 bug).
   Gated on either task-view permission, matching GET /tasks/{id}: the assignee holds view-assigned,
   design management holds view-all, and the handler decides involvement. *@
@page "/tarefas/{TaskId:guid}"
@attribute [Authorize(Policy = "tasks.view-assigned,tasks.view-all")]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Tarefa</PageTitle>

<TaskDetailView TaskId="TaskId" />

@code {
    [Parameter]
    public Guid TaskId { get; set; }
}
