@page "/usuarios"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@using BriefMe.Application.Common.Dtos
@using BriefMe.Application.UseCases.Users
@using BriefMe.Domain.Enums
@using BriefMe.Domain.Repositories
@using BriefMe.Web.Contracts.Common
@using Microsoft.AspNetCore.Authorization
@inject IUsersApiClient UsersApi
@inject AuthSessionStore SessionStore
@inject NavigationManager NavigationManager

<PageTitle>Usuários</PageTitle>

<PageContainer>
    <PageHeader Title="Usuários" Description="Gerencie os usuários e seus perfis de acesso.">
        <Actions>
            <Button Icon="IconName.UserPlus" OnClick="NavigateToNew">Novo usuário</Button>
        </Actions>
    </PageHeader>

    <form @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault="true" class="mt-8 flex flex-wrap items-end gap-3">
        <FormField Label="Buscar" For="search" Class="min-w-[220px] flex-1">
            <Input id="search" type="search" @bind-Value="_search" placeholder="Nome ou e-mail" />
        </FormField>

        <FormField Label="Status" For="status">
            <NativeSelect id="status" @bind-Value="_statusFilter">
                <option value="">Todos</option>
                <option value="@nameof(UserStatus.Active)">Ativo</option>
                <option value="@nameof(UserStatus.Inactive)">Inativo</option>
            </NativeSelect>
        </FormField>

        <FormField Label="Perfil" For="role">
            <NativeSelect id="role" @bind-Value="_roleFilter">
                <option value="">Todos</option>
                @foreach (var role in UserRoleLabels.All)
                {
                    <option value="@role">@UserRoleLabels.Label(role)</option>
                }
            </NativeSelect>
        </FormField>

        <FormField Label="Ordenar por" For="sort">
            <NativeSelect id="sort" @bind-Value="_sortFilter">
                <option value="FullName:false">Nome (A–Z)</option>
                <option value="FullName:true">Nome (Z–A)</option>
                <option value="Email:false">E-mail (A–Z)</option>
                <option value="Email:true">E-mail (Z–A)</option>
            </NativeSelect>
        </FormField>

        <Button Type="submit" Variant="ButtonVariant.Outline" Icon="IconName.Filter">Aplicar</Button>
    </form>

    <Card Class="mt-5 overflow-hidden">
        @if (_isLoading)
        {
            <LoadingState Text="Carregando usuários..." />
        }
        else if (_errorMessage is not null)
        {
            <EmptyState Title="@_errorMessage" Tone="EmptyStateTone.Danger">
                <Button Variant="ButtonVariant.Secondary" Icon="IconName.RotateCcw" OnClick="ReloadAsync">Tentar novamente</Button>
            </EmptyState>
        }
        else if (_page is null || _page.Items.Count == 0)
        {
            <EmptyState Title="Nenhum usuário encontrado" Description="Ajuste os filtros e tente novamente." Icon="IconName.Users" />
        }
        else
        {
            <Table Class="min-w-[720px]">
                <Header>
                    <TableHead>Nome</TableHead>
                    <TableHead>E-mail</TableHead>
                    <TableHead>Status</TableHead>
                    <TableHead>Perfil</TableHead>
                    <TableHead Class="text-right">Ações</TableHead>
                </Header>
                <ChildContent>
                    @foreach (var user in _page.Items)
                    {
                        <TableRow>
                            <TableCell Primary="true">
                                <span class="flex items-center gap-3">
                                    <UserAvatar UserId="user.UserId" Name="@user.FullName" AvatarVersion="user.AvatarVersion" />
                                    @user.FullName
                                </span>
                            </TableCell>
                            <TableCell>@user.Email</TableCell>
                            <TableCell>
                                @if (user.Status == UserStatus.Active)
                                {
                                    <Badge Variant="BadgeVariant.Success">Ativo</Badge>
                                }
                                else
                                {
                                    <Badge>Inativo</Badge>
                                }
                            </TableCell>
                            <TableCell>@UserRoleLabels.Label(user.Role)</TableCell>
                            <TableCell Class="text-right">
                                <Button Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Icon="IconName.Pencil" OnClick="() => NavigateToEdit(user.UserId)">Editar</Button>
                            </TableCell>
                        </TableRow>
                    }
                </ChildContent>
            </Table>

            <Pagination Page="_page.Page" TotalPages="_page.TotalPages" TotalCount="_page.TotalCount" ItemLabel="usuário(s)"
                        OnPageChange="GoToPageAsync" />
        }
    </Card>
</PageContainer>

@code {
    private const int PageSize = 20;

    private bool _isLoading = true;
    private string? _errorMessage;
    private PagedResponse<UserListItemDto>? _page;

    private int _currentPage = 1;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _roleFilter = string.Empty;
    private string _sortFilter = "FullName:false";

    protected override async Task OnInitializedAsync()
    {
        // No interactive circuit during prerender means no restored token yet; the API call would go
        // out anonymous. Wait for the interactive pass and the session restore, same as Login.razor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        // Any filter/sort change restarts from page 1 to avoid landing outside the new range (USRLIST-04).
        _currentPage = 1;
        await LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var (sortField, sortDescending) = ParseSort(_sortFilter);
        var query = new UserListQuery(
            Page: _currentPage,
            PageSize: PageSize,
            Search: string.IsNullOrWhiteSpace(_search) ? null : _search,
            Status: ParseStatus(_statusFilter),
            Role: ParseRole(_roleFilter),
            SortField: sortField,
            SortDescending: sortDescending);

        var result = await UsersApi.GetUsersAsync(query);

        if (result.IsSuccess)
        {
            _page = result.Value;
            _currentPage = _page.Page;
        }
        else
        {
            _page = null;
            _errorMessage = result.Error;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task GoToPageAsync(int page)
    {
        if (_page is null || page < 1 || page > _page.TotalPages)
            return;

        _currentPage = page;
        await LoadAsync();
    }

    // Blazor user screens live under /usuarios to avoid colliding with the /users REST API namespace
    // (USR-034). USR-043 will own /usuarios/novo and /usuarios/{id}.
    private void NavigateToNew() => NavigationManager.NavigateTo("/usuarios/novo");

    private void NavigateToEdit(Guid userId) => NavigationManager.NavigateTo($"/usuarios/{userId}");


    private static UserStatus? ParseStatus(string value) =>
        Enum.TryParse<UserStatus>(value, out var status) ? status : null;

    private static UserRole? ParseRole(string value) =>
        Enum.TryParse<UserRole>(value, out var role) ? role : null;

    private static (UserSortField Field, bool Descending) ParseSort(string value)
    {
        var parts = value.Split(':');
        var field = parts.Length > 0 && Enum.TryParse<UserSortField>(parts[0], out var parsed)
            ? parsed
            : UserSortField.FullName;
        var descending = parts.Length > 1 && bool.TryParse(parts[1], out var desc) && desc;
        return (field, descending);
    }
}
