@* BRF-039 (RF023) — progress and task timeline of one briefing.
   Route note: it lives under /briefings/{id}/acompanhamento, next to /briefings/novo and
   /briefings/{id}/editar. No collision with BriefingsController, whose routes are briefings,
   briefings/{id:guid} and literal suffixes (AmbiguousMatchException — the USR-042 bug).
   Gated on either briefing-view permission, matching GET /briefings/{id}/tracking: the requester holds
   view-own, design management holds view-all, and the handler decides involvement. *@
@page "/briefings/{BriefingId:guid}/acompanhamento"
@attribute [Authorize(Policy = "briefings.view-own,briefings.view-all")]
@using System.Globalization
@using BriefMe.Application.Common.Dtos
@using BriefMe.Application.UseCases.Categories
@using BriefMe.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@inject IBriefingsApiClient BriefingsApi
@inject AuthSessionStore SessionStore
@inject NavigationManager NavigationManager

<PageTitle>Acompanhamento do briefing</PageTitle>

<div class="min-h-full bg-[#090909] px-4 py-8 text-white sm:px-8">
    <div class="mx-auto max-w-[1100px]">
        <button type="button" @onclick="NavigateToList"
                class="text-[14px] font-medium text-[#999999] transition hover:text-white">
            ← Voltar para meus briefings
        </button>

        @if (_isLoading)
        {
            <div class="mt-[30px] flex items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-[15px] text-[#999999]">
                <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
                <span>Carregando acompanhamento...</span>
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="mt-[30px] flex flex-col items-center justify-center gap-3 rounded-[20px] border border-[#262626] bg-[#141414] py-24 text-center">
                <p class="text-[15px] text-[#ef4444]">@_errorMessage</p>
                <button type="button" @onclick="ReloadAsync"
                        class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                    Tentar novamente
                </button>
            </div>
        }
        else if (_tracking is not null)
        {
            <div class="mt-[20px] flex flex-wrap items-start justify-between gap-4">
                <div>
                    <h1 class="text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">@_tracking.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(_tracking.Objective))
                    {
                        <p class="mt-1 max-w-[720px] text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
                            @_tracking.Objective
                        </p>
                    }
                </div>

                <span class="inline-flex items-center rounded-[100px] px-[10px] py-[4px] text-[13px] font-medium @BriefingLabels.StatusBadgeClass(_tracking.Status)">
                    @BriefingLabels.Status(_tracking.Status)
                </span>
            </div>

            <dl class="mt-[20px] grid grid-cols-1 gap-[12px] sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-[10px] border border-[#262626] bg-[#141414] px-[14px] py-[10px]">
                    <dt class="text-[13px] font-medium text-[#999999]">Solicitante</dt>
                    <dd class="mt-1 text-[15px] text-white">@(_tracking.RequesterName ?? "—")</dd>
                </div>
                <div class="rounded-[10px] border border-[#262626] bg-[#141414] px-[14px] py-[10px]">
                    <dt class="text-[13px] font-medium text-[#999999]">Categoria</dt>
                    <dd class="mt-1 text-[15px] text-white">@CategoryName(_tracking.CategoryId)</dd>
                </div>
                <div class="rounded-[10px] border border-[#262626] bg-[#141414] px-[14px] py-[10px]">
                    <dt class="text-[13px] font-medium text-[#999999]">Prioridade</dt>
                    <dd class="mt-1 text-[15px] text-white">@BriefingLabels.Priority(_tracking.Priority)</dd>
                </div>
                <div class="rounded-[10px] border border-[#262626] bg-[#141414] px-[14px] py-[10px]">
                    <dt class="text-[13px] font-medium text-[#999999]">Entrega desejada</dt>
                    <dd class="mt-1 text-[15px] text-white">
                        @(_tracking.DesiredDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")
                    </dd>
                </div>
            </dl>

            <section class="mt-[20px] rounded-[20px] border border-[#262626] bg-[#141414] p-[30px]" aria-labelledby="progressTitle">
                <div class="flex flex-wrap items-end justify-between gap-3">
                    <div>
                        <h2 id="progressTitle" class="text-[13px] font-medium text-[#999999]">Progresso</h2>
                        <p class="mt-1 text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">
                            @PercentageLabel(_tracking.Progress.Percentage)%
                        </p>
                    </div>
                    <p class="text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
                        @_tracking.Progress.ApprovedTasks de @_tracking.Progress.TotalTasks tarefa(s) aprovada(s)
                    </p>
                </div>

                @* The width is the value the backend computed (BRF-035); the component never divides. *@
                <div class="mt-[15px] h-[10px] w-full overflow-hidden rounded-[100px] bg-[#1c1c1c]"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@PercentageLabel(_tracking.Progress.Percentage)"
                     aria-labelledby="progressTitle">
                    <div class="h-full rounded-[100px] transition-[width] @(_tracking.Progress.IsComplete ? "bg-[#22c55e]" : "bg-white")"
                         style="width: @BarWidth(_tracking.Progress.Percentage)"></div>
                </div>

                @if (_tracking.Progress.IsComplete)
                {
                    <p class="mt-[12px] text-[14px] font-medium tracking-[-0.14px] text-[#22c55e]">
                        Todas as tarefas do briefing foram aprovadas.
                    </p>
                }
            </section>

            <section class="mt-[20px] overflow-hidden rounded-[20px] border border-[#262626] bg-[#141414]" aria-labelledby="timelineTitle">
                <div class="border-b border-[#262626] px-[20px] py-[14px]">
                    <h2 id="timelineTitle" class="text-[15px] font-medium tracking-[-0.15px] text-white">Tarefas do briefing</h2>
                </div>

                @if (_tracking.Tasks.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center gap-1 py-24 text-center">
                        <p class="text-[15px] text-white">Nenhuma tarefa criada ainda</p>
                        <p class="text-[14px] text-[#999999]">
                            O briefing ainda não foi desdobrado em tarefas pela gestão de design.
                        </p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[860px] border-collapse text-left">
                            <thead>
                                <tr class="border-b border-[#262626] text-[13px] font-medium text-[#999999]">
                                    <th class="px-[20px] py-[14px]">Tarefa</th>
                                    <th class="px-[20px] py-[14px]">Status</th>
                                    <th class="px-[20px] py-[14px]">Responsável</th>
                                    <th class="px-[20px] py-[14px]">Prazo</th>
                                    <th class="px-[20px] py-[14px]">Prioridade</th>
                                    <th class="px-[20px] py-[14px] text-right">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in _tracking.Tasks)
                                {
                                    <tr class="border-b border-[#1a1a1a] text-[15px] last:border-b-0 @BriefingTaskLabels.RowClass(task.Status)">
                                        <td class="px-[20px] py-[14px] text-white">@task.Title</td>
                                        <td class="px-[20px] py-[14px]">
                                            <span class="inline-flex items-center rounded-[100px] px-[10px] py-[4px] text-[13px] font-medium @BriefingTaskLabels.StatusBadgeClass(task.Status)">
                                                @BriefingTaskLabels.Status(task.Status)
                                            </span>
                                        </td>
                                        <td class="px-[20px] py-[14px] text-[#999999]">@(task.DesignerName ?? "—")</td>
                                        <td class="px-[20px] py-[14px] text-[#999999]">
                                            @(task.Deadline?.ToString("dd/MM/yyyy") ?? "—")
                                        </td>
                                        <td class="px-[20px] py-[14px] text-[#999999]">@BriefingLabels.Priority(task.Priority)</td>
                                        <td class="px-[20px] py-[14px] text-right">
                                            @* Only a caller who may read a task at all is offered the link (BRF-034's gate). *@
                                            <AuthorizePermission Permission="tasks.view-assigned,tasks.view-all">
                                                <button type="button" @onclick="() => NavigateToTask(task.Id)"
                                                        class="text-[14px] font-medium text-[#0099ff] transition hover:underline">
                                                    Abrir
                                                </button>
                                            </AuthorizePermission>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid BriefingId { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;
    private BriefingTrackingDto? _tracking;
    private IReadOnlyList<CategoryListItemDto> _categories = [];

    protected override async Task OnInitializedAsync()
    {
        // No interactive circuit during prerender means no restored token yet — the call would go out
        // anonymous. Same guard as Briefings.razor / BriefingEditor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        // Best-effort: an empty catalog only degrades the category cell.
        _categories = await BriefingsApi.GetCategoriesAsync();

        await LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await BriefingsApi.GetBriefingTrackingAsync(BriefingId);

        if (result.IsSuccess)
        {
            _tracking = result.Value;
        }
        else
        {
            _tracking = null;
            _errorMessage = result.Error;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private string CategoryName(Guid categoryId) =>
        _categories.FirstOrDefault(category => category.Id == categoryId)?.Name ?? "—";

    // Display only. The value itself is the domain's (BRF-035) — rounding and the 0/100 edge guards already
    // happened in BriefingProgress; nothing here recomputes it.
    private static string PercentageLabel(decimal percentage) =>
        percentage.ToString("0.##", CultureInfo.InvariantCulture);

    // CSS needs a dot as the decimal separator whatever the request culture is.
    private static string BarWidth(decimal percentage) =>
        string.Create(CultureInfo.InvariantCulture, $"{percentage:0.##}%");

    private void NavigateToList() => NavigationManager.NavigateTo("/briefings/meus");

    private void NavigateToTask(Guid taskId) => NavigationManager.NavigateTo($"/tarefas/{taskId}");
}
