@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using BriefMe.Domain.Common
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthSessionStore SessionStore

<PageTitle>Entrar</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-canvas px-4 py-12">
    <div class="grid w-full max-w-[960px] items-stretch gap-6 lg:grid-cols-[7fr_5fr]">
    <Card Tone="CardTone.Teal" Class="hidden flex-col justify-between gap-12 p-8 lg:flex">
        <span class="text-title-lg">BriefMe</span>
        <div>
            <p class="text-display-md">Do briefing à entrega, em um só fluxo.</p>
            <p class="mt-4 text-body-md text-on-dark-soft">Solicitantes enviam, designers assumem e entregam — tudo rastreado.</p>
        </div>
    </Card>

    <Card Class="w-full p-6 sm:p-8">
        <h1 class="text-display-sm text-ink">Entrar</h1>
        <p class="mt-2 text-body-md text-muted">Acesse sua conta para continuar.</p>

        <EditForm Model="Model" FormName="login" OnValidSubmit="HandleValidSubmitAsync" class="mt-8 flex flex-col gap-4">
            <DataAnnotationsValidator />

            @if (_errorMessage is not null)
            {
                <Alert>@_errorMessage</Alert>
            }

            <FormField Label="E-mail" For="email">
                <FormInput id="email" @bind-Value="Model!.Email" type="email" autocomplete="username" disabled="@_isSubmitting" />
                <FormMessage For="() => Model.Email" />
            </FormField>

            <FormField Label="Senha" For="password">
                <FormInput id="password" @bind-Value="Model!.Password" type="password" autocomplete="current-password" disabled="@_isSubmitting" />
                <FormMessage For="() => Model.Password" />
            </FormField>

            <Button Type="submit" Icon="IconName.LogIn" Loading="_isSubmitting" Class="mt-2 w-full">
                @(_isSubmitting ? "Entrando..." : "Entrar")
            </Button>
        </EditForm>
    </Card>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "login")]
    private LoginFormModel? Model { get; set; }

    private const string GenericNetworkFailureMessage = "Não foi possível entrar. Tente novamente.";

    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // [SupplyParameterFromForm] leaves Model null unless this request posted the "login" form.
        Model ??= new();

        // Only the interactive pass has a restored session to check; during static prerendering
        // there is no circuit yet, so RestorationCompleted would never complete (see RedirectToLogin).
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        if (SessionStore.AccessToken is not null)
            NavigationManager.NavigateTo(LoginReturnUrlResolver.Resolve(ReturnUrl), replace: true);
    }

    private async Task HandleValidSubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        Result result;
        try
        {
            // Non-null: OnInitializedAsync always assigns Model before this handler can run.
            result = await AuthService.LoginAsync(Model!.Email, Model.Password);
        }
        catch (HttpRequestException)
        {
            // AuthService.LoginAsync (unlike its own refresh path) doesn't catch transport failures
            // itself — a blip here shouldn't break the P2 "always show a generic message" contract.
            _errorMessage = GenericNetworkFailureMessage;
            _isSubmitting = false;
            return;
        }

        if (result.IsFailure)
        {
            _errorMessage = result.Error;
            _isSubmitting = false;
            return;
        }

        NavigationManager.NavigateTo(LoginReturnUrlResolver.Resolve(ReturnUrl));
    }

    private sealed class LoginFormModel
    {
        [Required(ErrorMessage = "E-mail é obrigatório.")]
        [EmailAddress(ErrorMessage = "E-mail em formato inválido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Senha é obrigatória.")]
        public string Password { get; set; } = string.Empty;
    }
}
