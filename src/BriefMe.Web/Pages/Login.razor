@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using BriefMe.Domain.Common
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthSessionStore SessionStore

<PageTitle>Entrar</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-[#090909] px-4">
    <div class="w-full max-w-[400px] rounded-[20px] bg-[#141414] p-[30px]">
        <h1 class="text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">Entrar</h1>
        <p class="mt-2 text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
            Acesse sua conta para continuar.
        </p>

        <EditForm Model="Model" FormName="login" OnValidSubmit="HandleValidSubmitAsync" class="mt-[30px] flex flex-col gap-[15px]">
            <DataAnnotationsValidator />

            @if (_errorMessage is not null)
            {
                <div role="alert" class="rounded-[10px] border border-[#ef4444]/30 bg-[#ef4444]/10 px-[14px] py-[10px] text-[14px] text-[#ef4444]">
                    @_errorMessage
                </div>
            }

            <div class="flex flex-col gap-1">
                <label for="email" class="text-[13px] font-medium text-[#999999]">E-mail</label>
                <InputText id="email" @bind-Value="Model!.Email" type="email" autocomplete="username"
                           disabled="@_isSubmitting"
                           class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white placeholder:text-[#999999] focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50" />
                <ValidationMessage For="() => Model.Email" class="text-[13px] text-[#ef4444]" />
            </div>

            <div class="flex flex-col gap-1">
                <label for="password" class="text-[13px] font-medium text-[#999999]">Senha</label>
                <InputText id="password" @bind-Value="Model.Password" type="password" autocomplete="current-password"
                           disabled="@_isSubmitting"
                           class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white placeholder:text-[#999999] focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50" />
                <ValidationMessage For="() => Model.Password" class="text-[13px] text-[#ef4444]" />
            </div>

            <button type="submit" disabled="@_isSubmitting"
                    class="mt-2 inline-flex items-center justify-center gap-2 rounded-[100px] bg-white px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-black transition disabled:cursor-not-allowed disabled:opacity-60">
                @if (_isSubmitting)
                {
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-black/30 border-t-black"></span>
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "login")]
    private LoginFormModel? Model { get; set; }

    private const string GenericNetworkFailureMessage = "Não foi possível entrar. Tente novamente.";

    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // [SupplyParameterFromForm] leaves Model null unless this request posted the "login" form.
        Model ??= new();

        // Only the interactive pass has a restored session to check; during static prerendering
        // there is no circuit yet, so RestorationCompleted would never complete (see RedirectToLogin).
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        if (SessionStore.AccessToken is not null)
            NavigationManager.NavigateTo(LoginReturnUrlResolver.Resolve(ReturnUrl), replace: true);
    }

    private async Task HandleValidSubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        Result result;
        try
        {
            // Non-null: OnInitializedAsync always assigns Model before this handler can run.
            result = await AuthService.LoginAsync(Model!.Email, Model.Password);
        }
        catch (HttpRequestException)
        {
            // AuthService.LoginAsync (unlike its own refresh path) doesn't catch transport failures
            // itself — a blip here shouldn't break the P2 "always show a generic message" contract.
            _errorMessage = GenericNetworkFailureMessage;
            _isSubmitting = false;
            return;
        }

        if (result.IsFailure)
        {
            _errorMessage = result.Error;
            _isSubmitting = false;
            return;
        }

        NavigationManager.NavigateTo(LoginReturnUrlResolver.Resolve(ReturnUrl));
    }

    private sealed class LoginFormModel
    {
        [Required(ErrorMessage = "E-mail é obrigatório.")]
        [EmailAddress(ErrorMessage = "E-mail em formato inválido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Senha é obrigatória.")]
        public string Password { get; set; } = string.Empty;
    }
}
