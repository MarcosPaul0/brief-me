@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Início</PageTitle>

<PageContainer>
    <AuthorizeView>
        <PageHeader Title="@Greeting(context.User)"
                    Description="Módulo de Usuários e Acesso. Escolha uma área para começar." />

        <HomeNavOptions />
    </AuthorizeView>
</PageContainer>

@code {
    private static string Greeting(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? "Olá" : $"Olá, {name.Split(' ')[0]}";
    }
}
