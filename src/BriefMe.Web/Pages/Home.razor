@* No screen of its own: "/" (the login default and the header wordmark) forwards each role to its main page. *@
@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager NavigationManager

<PageTitle>BriefMe</PageTitle>

@if (_hasNoRole)
{
    <AccessDenied />
}
else
{
    <LoadingState Text="Carregando..." />
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private bool _hasNoRole;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;
        var landingPage = RoleLandingPage.For(state.User);

        if (landingPage is null)
        {
            _hasNoRole = true;
            return;
        }

        NavigationManager.NavigateTo(landingPage, replace: true);
    }
}
