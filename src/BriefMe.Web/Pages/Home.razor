@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Início</PageTitle>

<div class="min-h-full bg-[#090909] px-4 py-8 text-white sm:px-8">
    <div class="mx-auto max-w-[1100px]">
        <AuthorizeView>
            <div>
                <h1 class="text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">
                    Olá@(FirstName(context.User) is { } name ? $", {name}" : "")
                </h1>
                <p class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
                    Módulo de Usuários e Acesso. Escolha uma área para começar.
                </p>
            </div>

            <HomeNavOptions />
        </AuthorizeView>
    </div>
</div>

@code {
    private static string? FirstName(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? null : name.Split(' ')[0];
    }
}
