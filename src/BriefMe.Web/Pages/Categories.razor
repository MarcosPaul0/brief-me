@page "/categorias"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@using BriefMe.Application.Common.Dtos
@using BriefMe.Domain.Common
@using BriefMe.Web.Contracts.Categories
@using Microsoft.AspNetCore.Authorization
@inject ICategoriesApiClient CategoriesApi
@inject AuthSessionStore SessionStore

<PageTitle>Categorias</PageTitle>

<div class="min-h-full bg-[#090909] px-4 py-8 text-white sm:px-8">
    <div class="mx-auto max-w-[900px]">
        <div>
            <h1 class="text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">Categorias</h1>
            <p class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
                Tipos de trabalho que os solicitantes escolhem ao abrir um briefing. Categorias inativas somem do formulário, mas continuam nos briefings existentes.
            </p>
        </div>

        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true"
              class="mt-[30px] flex flex-col gap-[15px] rounded-[20px] border border-[#262626] bg-[#141414] p-[24px]">
            <p class="text-[15px] font-medium text-white">@(_editingId is null ? "Nova categoria" : "Editar categoria")</p>

            @if (_formError is not null)
            {
                <div role="alert" class="rounded-[10px] border border-[#ef4444]/30 bg-[#ef4444]/10 px-[14px] py-[10px] text-[14px] text-[#ef4444]">
                    @_formError
                </div>
            }

            <div class="flex flex-wrap gap-[12px]">
                <div class="flex min-w-[220px] flex-1 flex-col gap-1">
                    <label for="name" class="text-[13px] font-medium text-[#999999]">Nome</label>
                    <input id="name" @bind="_name" disabled="@_isSaving"
                           class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white placeholder:text-[#999999] focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50" />
                </div>
                <div class="flex min-w-[220px] flex-[2] flex-col gap-1">
                    <label for="description" class="text-[13px] font-medium text-[#999999]">Descrição (opcional)</label>
                    <input id="description" @bind="_description" disabled="@_isSaving"
                           class="rounded-[10px] border border-[#262626] bg-[#1c1c1c] px-[14px] py-[10px] text-[15px] text-white placeholder:text-[#999999] focus:border-transparent focus:shadow-[0_0_0_1px_rgba(0,153,255,0.15)] focus:outline-none disabled:opacity-50" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-2">
                @if (_editingId is not null)
                {
                    <button type="button" @onclick="ResetForm" disabled="@_isSaving"
                            class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626] disabled:opacity-50">
                        Cancelar
                    </button>
                }
                <button type="submit" disabled="@_isSaving"
                        class="rounded-[100px] bg-white px-[15px] py-[10px] text-[14px] font-medium tracking-[-0.14px] text-black transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60">
                    @(_isSaving ? "Salvando..." : _editingId is null ? "Adicionar" : "Salvar")
                </button>
            </div>
        </form>

        <div class="mt-[20px] overflow-hidden rounded-[20px] border border-[#262626] bg-[#141414]">
            @if (_isLoading)
            {
                <div class="flex items-center justify-center gap-3 py-16 text-[15px] text-[#999999]">
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
                    <span>Carregando...</span>
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="flex flex-col items-center gap-3 py-16 text-center">
                    <p class="text-[15px] text-[#ef4444]">@_loadError</p>
                    <button type="button" @onclick="LoadAsync"
                            class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                        Tentar novamente
                    </button>
                </div>
            }
            else if (_categories.Count == 0)
            {
                <p class="py-16 text-center text-[15px] text-[#999999]">Nenhuma categoria cadastrada.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="border-b border-[#262626] text-[13px] font-medium text-[#999999]">
                                <th class="px-[20px] py-[14px]">Nome</th>
                                <th class="px-[20px] py-[14px]">Descrição</th>
                                <th class="px-[20px] py-[14px]">Status</th>
                                <th class="px-[20px] py-[14px]"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in _categories)
                            {
                                <tr class="border-b border-[#1a1a1a] text-[15px] last:border-b-0">
                                    <td class="px-[20px] py-[14px] text-white">@category.Name</td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">@(category.Description ?? "—")</td>
                                    <td class="px-[20px] py-[14px]">
                                        @if (category.IsActive)
                                        {
                                            <span class="inline-flex items-center rounded-[100px] bg-[#22c55e]/10 px-[10px] py-[4px] text-[13px] font-medium text-[#22c55e]">Ativa</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-[100px] bg-[#999999]/10 px-[10px] py-[4px] text-[13px] font-medium text-[#999999]">Inativa</span>
                                        }
                                    </td>
                                    <td class="px-[20px] py-[14px] text-right">
                                        <div class="flex items-center justify-end gap-3">
                                            <button type="button" @onclick="() => StartEdit(category)"
                                                    class="text-[14px] font-medium text-[#0099ff] transition hover:underline">
                                                Editar
                                            </button>
                                            <button type="button" @onclick="() => ToggleStatusAsync(category)" disabled="@(_togglingId == category.Id)"
                                                    class="text-[14px] font-medium text-[#999999] transition hover:text-white disabled:opacity-50">
                                                @(category.IsActive ? "Desativar" : "Ativar")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (_rowError is not null)
        {
            <div role="alert" class="mt-[12px] rounded-[10px] border border-[#ef4444]/30 bg-[#ef4444]/10 px-[14px] py-[10px] text-[14px] text-[#ef4444]">
                @_rowError
            </div>
        }
    </div>
</div>

@code {
    private bool _isLoading = true;
    private string? _loadError;
    private IReadOnlyList<CategoryDto> _categories = [];

    private Guid? _editingId;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private bool _isSaving;
    private string? _formError;

    private Guid? _togglingId;
    private string? _rowError;

    protected override async Task OnInitializedAsync()
    {
        // No token before the interactive restore — same guard as the other admin screens.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        var result = await CategoriesApi.GetCategoriesAsync();
        if (result.IsSuccess)
            _categories = result.Value;
        else
            _loadError = result.Error;

        _isLoading = false;
    }

    private void StartEdit(CategoryDto category)
    {
        _editingId = category.Id;
        _name = category.Name;
        _description = category.Description ?? string.Empty;
        _formError = null;
    }

    private void ResetForm()
    {
        _editingId = null;
        _name = string.Empty;
        _description = string.Empty;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        _formError = null;
        _isSaving = true;

        var description = string.IsNullOrWhiteSpace(_description) ? null : _description;
        var result = _editingId is { } id
            ? await CategoriesApi.UpdateCategoryAsync(id, new UpdateCategoryRequest(_name, description))
            : await CategoriesApi.CreateCategoryAsync(new CreateCategoryRequest(_name, description));

        _isSaving = false;

        if (result.IsFailure)
        {
            _formError = FirstMessage(result);
            return;
        }

        ResetForm();
        await LoadAsync();
    }

    private async Task ToggleStatusAsync(CategoryDto category)
    {
        _rowError = null;
        _togglingId = category.Id;

        var result = await CategoriesApi.ChangeCategoryStatusAsync(category.Id, !category.IsActive);

        _togglingId = null;

        if (result.IsFailure)
        {
            _rowError = FirstMessage(result);
            return;
        }

        await LoadAsync();
    }

    private static string? FirstMessage(Result result) =>
        result.Errors.Count > 0 ? result.Errors[0].ErrorMessage : result.Error;
}
