@* The requester's own briefings.
   Route note: the Blazor screen lives at /briefings/meus because @page "/briefings" would collide with
   BriefingsController's [Route("briefings")] GET (AmbiguousMatchException — the USR-042 bug). *@
@page "/briefings/meus"
@attribute [Authorize(Roles = nameof(UserRole.Requester))]
@using BriefMe.Application.Common.Dtos
@using BriefMe.Domain.Enums
@using BriefMe.Web.Contracts.Common
@using Microsoft.AspNetCore.Authorization
@inject IBriefingsApiClient BriefingsApi
@inject AuthSessionStore SessionStore
@inject NavigationManager NavigationManager

<PageTitle>Meus briefings</PageTitle>

<PageContainer>
    <PageHeader Title="Meus briefings" Description="Acompanhe o andamento das suas solicitações de design.">
        <Actions>
            <Button Icon="IconName.Plus" OnClick="NavigateToNew">Novo briefing</Button>
        </Actions>
    </PageHeader>

    <form @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault="true" class="mt-8 flex flex-wrap items-end gap-3">
        <FormField Label="Status" For="status">
            <NativeSelect id="status" @bind-Value="_statusFilter">
                <option value="">Todos</option>
                @foreach (var status in StatusOptions)
                {
                    <option value="@status.ToString()">@BriefingLabels.Status(status)</option>
                }
            </NativeSelect>
        </FormField>

        @if (_categories.Count > 0)
        {
            <FormField Label="Categoria" For="category">
                <NativeSelect id="category" @bind-Value="_categoryFilter">
                    <option value="">Todas</option>
                    @foreach (var category in _categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </NativeSelect>
            </FormField>
        }

        <Button Type="submit" Variant="ButtonVariant.Outline" Icon="IconName.Filter">Aplicar</Button>
    </form>

    @if (_actionError is not null)
    {
        <Alert Class="mt-5">@_actionError</Alert>
    }

    <div class="mt-5">
        <BriefingListTable Page="_page" IsLoading="_isLoading" ErrorMessage="@_errorMessage" ShowDesigner="true"
                           EmptyHint="Ajuste os filtros ou abra um novo briefing."
                           OnPageChange="GoToPageAsync" OnRetry="LoadAsync">
            <RowActions Context="briefing">
                <Button Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Icon="IconName.Eye" OnClick="() => NavigateToDetail(briefing.Id)">Abrir</Button>
                @if (CanEdit(briefing.Status))
                {
                    <Button Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Icon="IconName.Pencil" OnClick="() => NavigateToEdit(briefing.Id)">Editar</Button>
                    <Button Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="text-error-ink!" Icon="IconName.Ban" OnClick="() => RequestCancel(briefing)">Cancelar</Button>
                }
            </RowActions>
        </BriefingListTable>
    </div>
</PageContainer>

<Dialog Open="_cancelTarget is not null" OnClose="DismissCancel" Dismissible="!_isCancelling"
        Title="Cancelar briefing"
        Description="@($"O briefing \"{_cancelTarget?.Title}\" será cancelado e não poderá ser reaberto.")">
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="DismissCancel" Disabled="_isCancelling">Voltar</Button>
        <Button Variant="ButtonVariant.Destructive" Icon="IconName.Ban" OnClick="ConfirmCancelAsync" Loading="_isCancelling">
            @(_isCancelling ? "Cancelando..." : "Confirmar cancelamento")
        </Button>
    </Footer>
</Dialog>

@code {
    private const int PageSize = 20;

    private static readonly BriefingStatus[] StatusOptions = Enum.GetValues<BriefingStatus>();

    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _actionError;
    private PagedResponse<BriefingListItemDto>? _page;
    private IReadOnlyList<CategoryListItemDto> _categories = [];

    private int _currentPage = 1;
    private string _statusFilter = string.Empty;
    private string _categoryFilter = string.Empty;

    private BriefingListItemDto? _cancelTarget;
    private bool _isCancelling;

    protected override async Task OnInitializedAsync()
    {
        // No interactive circuit during prerender means no restored token yet — the call would go out
        // anonymous. Same guard as Users.razor / BriefingEditor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        // Best-effort: an empty catalog just hides the category filter.
        _categories = await BriefingsApi.GetCategoriesAsync();

        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        // A filter change restarts from page 1 so a shrinking result set never leaves the view out of range.
        _currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var query = new BriefingListQuery(
            Page: _currentPage,
            PageSize: PageSize,
            Status: ParseStatus(_statusFilter),
            CategoryId: ParseCategoryId(_categoryFilter));

        var result = await BriefingsApi.GetBriefingsAsync(query);

        if (result.IsSuccess)
        {
            _page = result.Value;
            _currentPage = _page.Page;
        }
        else
        {
            _page = null;
            _errorMessage = result.Error;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task GoToPageAsync(int page)
    {
        _currentPage = page;
        await LoadAsync();
    }

    private void RequestCancel(BriefingListItemDto briefing)
    {
        _actionError = null;
        _cancelTarget = briefing;
    }

    private void DismissCancel() => _cancelTarget = null;

    private async Task ConfirmCancelAsync()
    {
        if (_cancelTarget is null)
            return;

        _isCancelling = true;
        var result = await BriefingsApi.CancelBriefingAsync(_cancelTarget.Id);
        _isCancelling = false;
        _cancelTarget = null;

        // On failure the reload still runs: the row's real status is what makes a stale action correct itself.
        _actionError = result.IsFailure ? result.Error : null;

        await LoadAsync();
    }

    // Mirrors Briefing.IsOpenForRequester so the UI never offers an action the domain rejects.
    private static bool CanEdit(BriefingStatus status) =>
        status is BriefingStatus.Draft or BriefingStatus.Submitted;


    private void NavigateToNew() => NavigationManager.NavigateTo("/briefings/novo");

    private void NavigateToEdit(Guid briefingId) => NavigationManager.NavigateTo($"/briefings/{briefingId}/editar");

    private void NavigateToDetail(Guid briefingId) => NavigationManager.NavigateTo($"/briefings/{briefingId}/detalhes");

    private static BriefingStatus? ParseStatus(string value) =>
        Enum.TryParse<BriefingStatus>(value, out var status) ? status : null;

    private static Guid? ParseCategoryId(string value) =>
        Guid.TryParse(value, out var categoryId) ? categoryId : null;
}
