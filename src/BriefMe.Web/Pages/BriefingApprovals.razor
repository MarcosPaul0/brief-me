@* BRF-020 (RF011–RF014) — the Design Manager's approval queue.
   Route note: /briefings/aprovacoes is a literal that cannot collide with BriefingsController's
   briefings/{id:guid} nor with briefings/pending-approval (the USR-042 AmbiguousMatchException trap). *@
@page "/briefings/aprovacoes"
@attribute [Authorize(Policy = "briefings.view-all")]
@using BriefMe.Application.Common.Dtos
@using BriefMe.Application.UseCases.Briefings
@using BriefMe.Web.Contracts.Common
@using Microsoft.AspNetCore.Authorization
@inject IBriefingsApiClient BriefingsApi
@inject AuthSessionStore SessionStore

<PageTitle>Aprovações pendentes</PageTitle>

<div class="min-h-full bg-[#090909] px-4 py-8 text-white sm:px-8">
    <div class="mx-auto max-w-[1100px]">
        <div>
            <h1 class="text-[32px] font-medium leading-[1.13] tracking-[-1px] text-white">Aprovações pendentes</h1>
            <p class="mt-1 text-[15px] leading-[1.3] tracking-[-0.15px] text-[#999999]">
                Revise os briefings aguardando aprovação — do mais antigo para o mais recente.
            </p>
        </div>

        @if (_actionMessage is not null)
        {
            <div role="status" class="mt-[20px] rounded-[10px] border border-[#22c55e]/30 bg-[#22c55e]/10 px-[14px] py-[10px] text-[14px] text-[#22c55e]">
                @_actionMessage
            </div>
        }

        <div class="mt-[20px] overflow-hidden rounded-[20px] border border-[#262626] bg-[#141414]">
            @if (_isLoading)
            {
                <div class="flex items-center justify-center gap-3 py-24 text-[15px] text-[#999999]">
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#262626] border-t-white"></span>
                    <span>Carregando briefings...</span>
                </div>
            }
            else if (_errorMessage is not null)
            {
                <div class="flex flex-col items-center justify-center gap-3 py-24 text-center">
                    <p class="text-[15px] text-[#ef4444]">@_errorMessage</p>
                    <button type="button" @onclick="ReloadAsync"
                            class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[10px] text-[14px] font-medium text-white transition hover:bg-[#262626]">
                        Tentar novamente
                    </button>
                </div>
            }
            else if (_page is null || _page.Items.Count == 0)
            {
                <div class="flex flex-col items-center justify-center gap-1 py-24 text-center">
                    <p class="text-[15px] text-white">Nenhum briefing aguardando aprovação</p>
                    <p class="text-[14px] text-[#999999]">Novas solicitações aparecem aqui assim que forem enviadas.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[860px] border-collapse text-left">
                        <thead>
                            <tr class="border-b border-[#262626] text-[13px] font-medium text-[#999999]">
                                <th class="px-[20px] py-[14px]">Título</th>
                                <th class="px-[20px] py-[14px]">Solicitante</th>
                                <th class="px-[20px] py-[14px]">Prioridade</th>
                                <th class="px-[20px] py-[14px]">Categoria</th>
                                <th class="px-[20px] py-[14px]">Entrega desejada</th>
                                <th class="px-[20px] py-[14px]">Aberto em</th>
                                <th class="px-[20px] py-[14px] text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var briefing in _page.Items)
                            {
                                <tr class="border-b border-[#1a1a1a] text-[15px] last:border-b-0">
                                    <td class="px-[20px] py-[14px] text-white">@briefing.Title</td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">@(briefing.RequesterName ?? "—")</td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">@BriefingLabels.Priority(briefing.Priority)</td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">@(briefing.CategoryName ?? "—")</td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">
                                        @(briefing.DesiredDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")
                                    </td>
                                    <td class="px-[20px] py-[14px] text-[#999999]">@briefing.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td class="px-[20px] py-[14px] text-right">
                                        <button type="button" @onclick="() => OpenReview(briefing)"
                                                class="text-[14px] font-medium text-[#0099ff] transition hover:underline">
                                            Revisar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[#262626] px-[20px] py-[14px]">
                    <p class="text-[14px] text-[#999999]">
                        Página @_page.Page de @Math.Max(_page.TotalPages, 1) • @_page.TotalCount briefing(s) pendente(s)
                    </p>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousPageAsync" disabled="@(!CanGoPrevious)"
                                class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[8px] text-[14px] font-medium text-white transition hover:bg-[#262626] disabled:cursor-not-allowed disabled:opacity-40">
                            Anterior
                        </button>
                        <button type="button" @onclick="NextPageAsync" disabled="@(!CanGoNext)"
                                class="rounded-[100px] bg-[#1c1c1c] px-[15px] py-[8px] text-[14px] font-medium text-white transition hover:bg-[#262626] disabled:cursor-not-allowed disabled:opacity-40">
                            Próxima
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_reviewTarget is not null)
{
    <BriefingReviewPanel Briefing="_reviewTarget" OnReviewed="OnReviewedAsync" OnDismiss="DismissReview" />
}

@code {
    private const int PageSize = 20;

    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _actionMessage;
    private PagedResponse<PendingApprovalBriefingDto>? _page;
    private PendingApprovalBriefingDto? _reviewTarget;

    private int _currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        // No interactive circuit during prerender means no restored token yet — the call would go out
        // anonymous. Same guard as Briefings.razor / Users.razor.
        if (!RendererInfo.IsInteractive)
            return;

        await SessionStore.RestorationCompleted;

        await LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await BriefingsApi.GetPendingApprovalBriefingsAsync(_currentPage, PageSize);

        if (result.IsSuccess)
        {
            _page = result.Value;
            _currentPage = _page.Page;

            // A decision empties the last page of the queue; step back so the reviewer never lands on a
            // valid-but-empty page after clearing it.
            if (_page.Items.Count == 0 && _currentPage > 1)
            {
                _currentPage--;
                await LoadAsync();
                return;
            }
        }
        else
        {
            _page = null;
            _errorMessage = result.Error;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private bool CanGoPrevious => _page is { Page: > 1 };

    private bool CanGoNext => _page is not null && _page.Page < _page.TotalPages;

    private async Task PreviousPageAsync()
    {
        if (!CanGoPrevious)
            return;

        _currentPage = _page!.Page - 1;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!CanGoNext)
            return;

        _currentPage = _page!.Page + 1;
        await LoadAsync();
    }

    private void OpenReview(PendingApprovalBriefingDto briefing)
    {
        _actionMessage = null;
        _reviewTarget = briefing;
    }

    private void DismissReview() => _reviewTarget = null;

    private async Task OnReviewedAsync(string message)
    {
        _reviewTarget = null;
        _actionMessage = message;

        // The reviewed briefing has left AwaitingApproval, so the reload is what removes its row.
        await LoadAsync();
    }
}
