@*
    Stacks a field's label, control and helper text. The control (Input, FormInput, ...) and, inside an
    EditForm, its FormMessage go in ChildContent — FormMessage needs a typed For expression this wrapper
    deliberately does not carry.
*@
<div class="@ClassNames.Join("flex flex-col gap-1.5", Class)" @attributes="AdditionalAttributes">
    @if (Label is not null)
    {
        <Label For="@For">@Label</Label>
    }
    @ChildContent
    @if (Description is not null)
    {
        <p class="text-body-sm text-muted">@Description</p>
    }
</div>

@code {
    [Parameter]
    public string? Label { get; set; }

    /// <summary>The control's id, so clicking the label focuses it.</summary>
    [Parameter]
    public string? For { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
