@* Page body: cream canvas ground, gutters, and the one centred column every screen shares (max-w-page, the
   header's width too). There is deliberately no width parameter — narrow content stays narrow inside it. *@
<div class="min-h-full bg-canvas px-4 py-10 sm:px-8 sm:py-12">
    <div class="@ClassNames.Join("mx-auto max-w-page", Class)">
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
