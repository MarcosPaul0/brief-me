@* Page body: canvas ground, gutters, and a centred column capped at Width. *@
<div class="min-h-full bg-canvas px-4 py-8 sm:px-8">
    <div class="@ClassNames.Join("mx-auto", MaxWidth, Class)">
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public PageWidth Width { get; set; } = PageWidth.Xl;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string MaxWidth => Width switch
    {
        PageWidth.Sm => "max-w-[560px]",
        PageWidth.Md => "max-w-[760px]",
        PageWidth.Lg => "max-w-[900px]",
        _ => "max-w-[1100px]"
    };
}
