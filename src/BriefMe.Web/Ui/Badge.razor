@* Status tag. Square-ish (rounded-sm) — DESIGN-sap.md: nothing in the system is a pill. *@
<span class="@ClassNames.Join("inline-flex items-center whitespace-nowrap rounded-sm px-2 py-0.5 text-caption font-medium", VariantClasses, Class)"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    [Parameter]
    public BadgeVariant Variant { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClasses => Variant switch
    {
        BadgeVariant.Info => "bg-band-blue text-primary",
        BadgeVariant.Success => "bg-positive-surface text-positive",
        BadgeVariant.Warning => "bg-critical-surface text-critical",
        BadgeVariant.Danger => "bg-negative-surface text-negative",
        _ => "bg-chrome text-ink-list"
    };
}
