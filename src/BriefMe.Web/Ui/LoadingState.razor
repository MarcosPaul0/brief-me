@* Centred placeholder while a region loads. *@
<div class="@ClassNames.Join("flex items-center justify-center gap-3 py-24 text-body-sm text-muted", Class)">
    <Spinner Class="text-ink" />
    <span>@Text</span>
</div>

@code {
    [Parameter]
    public string Text { get; set; } = "Carregando...";

    [Parameter]
    public string? Class { get; set; }
}
