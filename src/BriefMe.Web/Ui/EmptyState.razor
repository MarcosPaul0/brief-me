@*
    Centred message for a region with nothing to show — no results, not found, or a failed load (Tone Danger).
    ChildContent is the follow-up action (retry, back).
*@
<div class="@ClassNames.Join("flex flex-col items-center justify-center gap-1 px-6 py-24 text-center", Class)">
    <p class="@(Tone == EmptyStateTone.Danger ? "text-list font-medium text-negative" : "text-list font-medium text-ink")">@Title</p>
    @if (Description is not null)
    {
        <p class="text-caption text-ink-meta">@Description</p>
    }
    @if (ChildContent is not null)
    {
        <div class="mt-3">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public EmptyStateTone Tone { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
