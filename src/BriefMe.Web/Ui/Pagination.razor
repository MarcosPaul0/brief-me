@* Pager under a list: position summary plus previous/next, each disabled at its bound. *@
<div class="@ClassNames.Join("flex flex-wrap items-center justify-between gap-3 border-t border-hairline px-4 py-3", Class)">
    <p class="text-body-sm text-muted">
        Página @Page de @Math.Max(TotalPages, 1) • @TotalCount @ItemLabel
    </p>
    <div class="flex items-center gap-2">
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(Page <= 1)"
                Icon="IconName.ChevronLeft" OnClick="() => OnPageChange.InvokeAsync(Page - 1)">
            Anterior
        </Button>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(Page >= TotalPages)"
                OnClick="() => OnPageChange.InvokeAsync(Page + 1)">
            Próxima
            <Icon Name="IconName.ChevronRight" />
        </Button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public int Page { get; set; }

    [Parameter, EditorRequired]
    public int TotalPages { get; set; }

    [Parameter, EditorRequired]
    public int TotalCount { get; set; }

    /// <summary>Noun after the count, already pluralised by the caller (e.g. "briefing(s)").</summary>
    [Parameter]
    public string ItemLabel { get; set; } = "item(s)";

    [Parameter]
    public EventCallback<int> OnPageChange { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
