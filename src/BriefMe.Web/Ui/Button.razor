@*
    The app's action control (DESIGN-clay.md button-primary / button-secondary). Renders an <a> when Href is set,
    otherwise a <button>. Icon leads the label; Loading implies disabled and swaps the icon for a spinner.
*@
@if (Href is not null)
{
    <a href="@(IsDisabled ? null : Href)" aria-disabled="@(IsDisabled ? "true" : null)"
       class="@ClassNames.Join(Classes, IsDisabled ? "pointer-events-none" : null)" @attributes="AdditionalAttributes">
        @Content
    </a>
}
else
{
    <button type="@Type" disabled="@IsDisabled" @onclick="OnClick" class="@Classes" @attributes="AdditionalAttributes">
        @Content
    </button>
}

@code {
    [Parameter]
    public ButtonVariant Variant { get; set; }

    [Parameter]
    public ButtonSize Size { get; set; }

    /// <summary>The <c>type</c> attribute: <c>button</c> unless the button submits its form.</summary>
    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string? Href { get; set; }

    /// <summary>Leading glyph before the label.</summary>
    [Parameter]
    public IconName? Icon { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsDisabled => Disabled || Loading;

    private RenderFragment Content => __builder =>
    {
        if (Loading)
        {
            <Spinner />
        }
        else if (Icon is { } icon)
        {
            <Icon Name="icon" />
        }
        @ChildContent
    };

    private string Classes => ClassNames.Join(
        "inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-md transition-colors " +
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink " +
        "disabled:cursor-not-allowed disabled:opacity-50",
        VariantClasses,
        SizeClasses,
        Class);

    private string VariantClasses => Variant switch
    {
        ButtonVariant.Secondary => "bg-surface-card text-ink hover:bg-surface-strong",
        ButtonVariant.Outline => "border border-hairline bg-canvas text-ink hover:bg-surface-soft",
        ButtonVariant.Ghost => "text-body hover:bg-surface-card hover:text-ink",
        ButtonVariant.Link => "font-semibold text-ink underline underline-offset-4",
        ButtonVariant.Destructive => "bg-error-ink text-on-primary active:bg-error-ink/90",
        _ => "bg-primary text-on-primary active:bg-primary-active " +
             "disabled:bg-primary-disabled disabled:text-muted disabled:opacity-100"
    };

    private string SizeClasses => (Variant, Size) switch
    {
        // A link-styled button keeps the text's own box so it lines up with surrounding copy.
        (ButtonVariant.Link, ButtonSize.Sm) => "gap-1.5 text-body-sm",
        (ButtonVariant.Link, _) => "gap-1.5 text-body-md",
        (_, ButtonSize.Sm) => "h-9 rounded-sm px-3.5 text-button",
        _ => "h-11 px-5 text-button"
    };
}
