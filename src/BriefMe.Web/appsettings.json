{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=briefme;Username=briefme;Password=briefme"
  },
  "PasswordHasher": {
    "WorkFactor": 11
  },
  "Jwt": {
    "Issuer": "BriefMe",
    "Audience": "BriefMe",
    "SecretKey": "",
    "AccessTokenMinutes": 15
  },
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "SlaMonitor": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "StartupDelaySeconds": 30,
    "BatchSize": 200,
    "MaxItemsPerRun": 5000
  },
  "FileStorage": {
    "Provider": "Local",
    "RootPath": "App_Data/uploads",
    "MaxSizeBytes": 26214400,
    "AllowedExtensions": [
      ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".svg",
      ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
      ".zip", ".psd", ".ai", ".txt", ".csv"
    ],
    "Minio": {
      "Endpoint": "localhost:9000",
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "briefme-attachments",
      "UseSsl": false
    }
  },
  "Api": {
    "BaseAddress": "https://localhost:7203"
  }
}
